  {id:'YAO-MC-102',site:'Magasin central',workshop:'Yaourt',product:'Yaourt nature 125 ml',flour:0,ingredients:{lait:40,'sucre-mp':5,levure:1},expected:320,dough:314,good:310,failed:4,status:'Distribuée',createdBy:'Flore Gandonou',createdDate:date,steps:['Préparation du lait','Ensemencement','Fermentation · 6 h · 42 °C','Conditionnement en pots','Distribution'].map(label=>({label,user:'Flore Gandonou',at}))},
  {id:'GLA-MC-103',site:'Magasin central',workshop:'Crème glacée',product:'Coco · bac 5 L',flour:0,ingredients:{lait:25,beurre:5,'sucre-mp':6},expected:24,dough:23,good:23,failed:0,status:'Distribuée',createdBy:'Sabi Toko',createdDate:date,steps:['Préparation du mix','Maturation','Turbinage','Mise en pots / bacs','Congélation','Distribution'].map(label=>({label,user:'Sabi Toko',at}))},
]}

function seedData(): DemoData {
  const stocks = Object.fromEntries(sites.map((site, si) => [
    site,
    Object.fromEntries(products.map((p, pi) => [p.id, site === 'Magasin central' ? 240 - pi * 4 : 34 + si * 8 + pi * 3])),
  ])) as DemoData['stocks']
  ;[380,240,195,165].forEach((qty,i)=>stocks[sites[i]].farine=qty)
  ;[18,12,10,9].forEach((qty,i)=>stocks[sites[i]].levure=qty)
  ;[45,28,24,22].forEach((qty,i)=>stocks[sites[i]].sel=qty)
  ;[220,145,128,116].forEach((qty,i)=>stocks[sites[i]]['sucre-mp']=qty)
  ;[85,42,36,31].forEach((qty,i)=>stocks[sites[i]].beurre=qty)
  ;[160,95,78,72].forEach((qty,i)=>stocks[sites[i]].lait=qty)
  ;[620,310,275,240].forEach((qty,i)=>stocks[sites[i]].oeufs=qty)
  const tickets: Ticket[] = []
  const base = { 'Centre-Ville': 510000, 'Les Palmiers': 438000, 'Marché': 366000 }
  shops.forEach((site, si) => {
    for (let d = 0; d < 14; d++) {
      const date = new Date(); date.setDate(date.getDate() - d)
      tickets.push({ id: `T-${si}-${d}`, site, total: base[site] / 8 + ((d * 713 + si * 1900) % 18000), count: 28 + ((d + si) % 12), payment: 'Espèces', date: date.toLocaleDateString('fr-FR'), cashier: 'Équipe caisse' })
    }
  })
  return {
    stocks, tickets,
    activities: [
      { id: 'a1', text: 'Réception de 20 sacs de farine validée', site: 'Magasin central', user: 'Jean Kpadonou', time: 'Il y a 12 min', kind: 'Stock' },
      { id: 'a2', text: 'Clôture de caisse sans écart', site: 'Centre-Ville', user: 'Clarisse Dossou', time: 'Il y a 28 min', kind: 'Caisse' },
      { id: 'a3', text: 'Fournée #F-208 distribuée', site: 'Magasin central', user: 'Marcel Adjovi', time: 'Il y a 41 min', kind: 'Production' },
    ],
    expenses: [
      { site: 'Centre-Ville', label: 'Facture électricité', amount: 68000, status: 'En attente' },
      { site: 'Les Palmiers', label: 'Transport livraison', amount: 18500, status: 'Validée' },
      { site: 'Marché', label: 'Entretien four', amount: 45000, status: 'En attente' },
    ],
    requests: [
      {id:'R-104',site:'Marché',requester:'Kossi Hounsa',date:'Aujourd’hui, 08:15',type:'Matières premières',urgency:'Normal',comment:'Réassort hebdomadaire',lines:[{productId:'bag',qty:80}],status:'En attente'},
      {id:'R-105',site:'Les Palmiers',requester:'Nadine Ahouansou',date:'Aujourd’hui, 09:02',type:'Dépannage produits finis',urgency:'Urgent',comment:'Forte demande ce matin',lines:[{productId:'bag',qty:140}],status:'En attente'},
      {id:'R-102',site:'Centre-Ville',requester:'Blaise Kpadonou',date:'Hier, 16:40',type:'Matières premières',urgency:'Normal',comment:'Farine, levure et emballages',lines:[{productId:'mie',qty:25},{productId:'sucre',qty:30}],status:'En livraison'},
    ],
    users: profiles,
    batches: demoWorkshopBatches(),
    inventories: demoInventories(),
  }
}

const navByRole: Record<Role, { label: string; icon: typeof Store; id: string }[]> = {
  manager: [
    { label: 'Espace central', icon: LayoutDashboard, id: 'dashboard' }, { label: 'Stock', icon: Boxes, id: 'stock' },
    { label: 'Trésorerie', icon: WalletCards, id: 'treasury' }, { label: 'Production', icon: Factory, id: 'production' },
    { label: 'Qualité', icon: ShieldCheck, id: 'quality' }, { label: 'Inventaires', icon: ClipboardCheck, id: 'inventory' }, { label: 'Équipe & accès', icon: Users, id: 'users' },
  ],
  gerant: [{ label: 'Mon site', icon: LayoutDashboard, id: 'dashboard' }, { label: 'Stock', icon: Boxes, id: 'stock' }, { label: 'Demandes', icon: ArrowLeftRight, id: 'requests' }, { label: 'Production', icon: Factory, id: 'production' }, { label: 'Inventaires', icon: ClipboardCheck, id: 'inventory' }, { label: 'Trésorerie', icon: WalletCards, id: 'treasury' }, { label: 'Activité', icon: Receipt, id: 'activity' }],
  caissier: [{ label: 'Caisse', icon: ShoppingBasket, id: 'pos' }, { label: 'Tickets', icon: Receipt, id: 'tickets' }, { label: 'Clôture', icon: ClipboardCheck, id: 'close' }],
  magasinier: [{ label: 'Magasin', icon: LayoutDashboard, id: 'dashboard' }, { label: 'Stock', icon: Boxes, id: 'stock' }, { label: 'Demandes', icon: ArrowLeftRight, id: 'requests' }, { label: 'Achats', icon: PackageCheck, id: 'purchases' }, { label: 'Production', icon: Factory, id: 'production' }],
  production: [{ label: 'Fournées', icon: Factory, id: 'production' }, { label: 'Historique', icon: Receipt, id: 'activity' }],
  qualite: [{ label: 'Péremptions', icon: ShieldCheck, id: 'quality' }, { label: 'Retraits', icon: Trash2, id: 'activity' }],
  inventaire: [{ label: 'Inventaires', icon: ClipboardCheck, id: 'inventory' }],
}

function Logo() {
  return <div className="logo"><span className="logo-mark"><Wheat size={23} /></span><span><b>Digital</b><small>Boulangerie</small></span></div>
}

export default function App() {
  const [profile, setProfile] = useState<Profile | null>(null)
  const [data, setData] = useState<DemoData>(() => {
    try {
      const saved = JSON.parse(localStorage.getItem('digital-boulangerie') || '')
      const customUsers = (saved.users || []).filter((u:Profile) => u.id.startsWith('u-'))
      const fresh=seedData()
      const migratedStocks=Object.fromEntries(sites.map(site=>[site,{...fresh.stocks[site],...(saved.stocks?.[site]||{})}])) as DemoData['stocks']
      const savedInventories=(saved.inventories||[]) as InventoryRecord[]
      const inventories=savedInventories.some(i=>i.id.startsWith('INV-2025'))?fresh.inventories:(savedInventories.length?savedInventories:fresh.inventories)
      const savedBatches=(saved.batches||[]).filter((b:Batch)=>b.steps) as Batch[],demoBatches=fresh.batches.filter(b=>!savedBatches.some((x:Batch)=>x.id===b.id))
      return { ...fresh, ...saved, stocks:migratedStocks, users: [...profiles, ...customUsers], requests: saved.requests?.[0]?.lines ? saved.requests : fresh.requests, batches:[...savedBatches,...demoBatches], inventories }
    } catch { return seedData() }
  })
  const [view, setView] = useState('dashboard')
  const [selectedSite, setSelectedSite] = useState<Site|'Tous les sites'>('Tous les sites')
  const [cart, setCart] = useState<Record<string, number>>({})
  const [toast, setToast] = useState('')
  const [ticket, setTicket] = useState<Ticket | null>(null)
  const [tourStep,setTourStep]=useState(0)
  const [showTour,setShowTour]=useState(false)
  const [helpOpen,setHelpOpen]=useState(false)
  const [theme,setTheme]=useState<'light'|'dark'|'auto'>(()=>(localStorage.getItem('digital-boulangerie-theme') as 'light'|'dark'|'auto')||'light')

  useEffect(() => localStorage.setItem('digital-boulangerie', JSON.stringify(data)), [data])
  useEffect(() => { if (toast) { const t = setTimeout(() => setToast(''), 2600); return () => clearTimeout(t) } }, [toast])
  useEffect(()=>{if(profile&&!localStorage.getItem(`tour-${profile.username}`)){setTourStep(0);setShowTour(true)}},[profile])
  useEffect(()=>{localStorage.setItem('digital-boulangerie-theme',theme);const dark=theme==='dark'||(theme==='auto'&&window.matchMedia('(prefers-color-scheme: dark)').matches);document.documentElement.dataset.theme=dark?'dark':'light';const media=window.matchMedia('(prefers-color-scheme: dark)');const sync=()=>{if(theme==='auto')document.documentElement.dataset.theme=media.matches?'dark':'light'};media.addEventListener('change',sync);return()=>media.removeEventListener('change',sync)},[theme])

  const activeSite = profile?.role === 'manager' || profile?.role === 'qualite' ? selectedSite : profile?.site
  const scopedSite:Site=activeSite==='Tous les sites'?'Magasin central':(activeSite||'Magasin central')
  const todayTickets = data.tickets.filter(t => t.date === today)
  const visibleTickets = profile?.role === 'manager' ? todayTickets : todayTickets.filter(t => t.site === activeSite)
  const totalSales = visibleTickets.reduce((s, t) => s + t.total, 0)

  function login(p: Profile) {
    setProfile(p); setView(p.role === 'caissier' ? 'pos' : p.role === 'production' ? 'production' : p.role === 'qualite' ? 'quality' : p.role === 'inventaire' ? 'inventory' : 'dashboard')
    setSelectedSite(p.site||'Tous les sites')
  }

  function transact(payment: string) {
    if (!profile?.site) return
    const items = Object.entries(cart).filter(([, q]) => q > 0)
    if (!items.length) return setToast('Ajoutez au moins un produit')
    const total = items.reduce((sum, [id, qty]) => sum + products.find(p => p.id === id)!.price * qty, 0)
    const newTicket: Ticket = { id: `T-${Date.now().toString().slice(-6)}`, site: profile.site, total, count: items.reduce((s, [, q]) => s + q, 0), payment, date: today, cashier: profile.name }
    setData(d => {
      const nextStock = { ...d.stocks[profile.site!] }
      items.forEach(([id, qty]) => nextStock[id] = Math.max(0, nextStock[id] - qty))
      return {
        ...d, stocks: { ...d.stocks, [profile.site!]: nextStock },
        tickets: [newTicket, ...d.tickets],
        activities: [{ id: `a-${Date.now()}`, text: `Vente ${newTicket.id} — ${money(total)}`, site: profile.site!, user: profile.name, time: 'À l’instant', kind: 'Vente' }, ...d.activities],
      }
    })
    setCart({}); setTicket(newTicket); setToast('Vente encaissée avec succès')
  }

  function reset() {
    const fresh = seedData(); setData(fresh); setCart({}); setToast('Données de démonstration restaurées')
  }

  if (!profile) return <Login users={data.users || profiles} onLogin={login} />

  const nav = navByRole[profile.role]
  return (
    <div className="app-shell">
      <aside>
        <Logo />
        <nav>{nav.map(item => <button key={item.id} className={view === item.id ? 'active' : ''} onClick={() => setView(item.id)}><item.icon size={19}/><span>{item.label}</span></button>)}</nav>
        <div className="aside-bottom">
          <button onClick={reset}><RotateCcw size={18}/><span>Réinitialiser la démo</span></button>
          <div className="demo-note">Démo – données fictives</div>
        </div>
      </aside>
      <main>
        <header>
          <div>
            <p className="eyebrow">{profile.title}</p>
            <h1>{view === 'dashboard' ? profile.role === 'manager' ? 'Espace central' : profile.role === 'magasinier' ? 'Magasin central' : 'Mon site' : nav.find(n => n.id === view)?.label}</h1>
            <p className="header-welcome">Bonjour {profile.name.split(' ')[0]} – {profile.title} – {activeSite || 'Tous les sites'}</p>
          </div>
          <div className="header-actions">
            {(profile.role === 'manager' || profile.role === 'qualite') && <select value={selectedSite} onChange={e => setSelectedSite(e.target.value as Site|'Tous les sites')}>{profile.role==='manager'&&<option>Tous les sites</option>}{(profile.role === 'manager' ? sites : shops).map(s => <option key={s}>{s}</option>)}</select>}
            <button className="icon-button"><Bell size={19}/><i>{profile.role==='magasinier'?Math.max(1,data.activities.filter(a=>a.site===activeSite&&a.kind==='Production').length):4}</i></button>
            <button className="icon-button tutorial-button" title="Aide" onClick={()=>setHelpOpen(true)}><CircleHelp size={19}/></button>
            <div className="theme-switch" title="Thème d’affichage">{theme==='light'?<Sun/>:theme==='dark'?<Moon/>:<Monitor/>}<select aria-label="Thème" value={theme} onChange={e=>setTheme(e.target.value as 'light'|'dark'|'auto')}><option value="light">Clair</option><option value="dark">Nuit</option><option value="auto">Auto</option></select></div>
            <button className="profile-chip" onClick={() => setProfile(null)}><span>{profile.initials}</span><b>{profile.name}</b><LogOut size={16}/></button>
          </div>
        </header>
        <section className="page">
          {view==='dashboard'&&profile.role==='magasinier'&&<div className="quick-actions"><button className="primary" onClick={()=>setView('stock')}><Plus/> Nouvelle entrée</button><button onClick={()=>setView('stock')}><Minus/> Nouvelle sortie</button><button onClick={()=>setView('requests')}><ArrowLeftRight/> Transfert vers un site</button><button onClick={()=>setView('purchases')}><PackageCheck/> Réception de commande</button></div>}
          {view === 'dashboard' && <Dashboard profile={profile} data={data} activeSite={activeSite} setSite={s => { setSelectedSite(s); }} />}
          {view === 'pos' && <POS site={profile.site!} data={data} cart={cart} setCart={setCart} transact={transact} />}
          {view === 'tickets' && <Tickets tickets={visibleTickets} />}
          {view === 'stock' && <Stock data={data} setData={setData} site={scopedSite} profile={profile} toast={setToast} />}
          {view === 'treasury' && <Treasury data={data} totalSales={totalSales} />}
          {view === 'activity' && <ActivityList items={data.activities.filter(a => profile.role === 'manager' || a.site === activeSite)} />}
          {view === 'requests' && <Requests data={data} setData={setData} toast={setToast} profile={profile} />}
          {view === 'production' && <Production toast={setToast} data={data} setData={setData} profile={profile.role==='manager'?{...profile,site:scopedSite}:profile} />}
          {view === 'quality' && <Quality site={scopedSite} toast={setToast} />}
          {view === 'inventory' && <Inventory data={data} setData={setData} profile={profile} toast={setToast} />}
          {view === 'users' && <UsersView data={data} setData={setData} toast={setToast} />}
          {view === 'purchases' && <Purchases toast={setToast} />}
          {view === 'close' && <CloseCash total={totalSales} toast={setToast} />}
          {view === 'help' && <HelpPage profile={profile}/>}
        </section>
      </main>
      {toast && <div className="toast"><PackageCheck size={19}/>{toast}</div>}
      {ticket && <div className="modal-backdrop"><div className="ticket-modal"><button className="modal-close" onClick={() => setTicket(null)}><X/></button><Wheat className="ticket-logo"/><h2>Le Fournil</h2><p>Ticket {ticket.id} · {ticket.date}</p><div className="ticket-total">{money(ticket.total)}</div><p>{ticket.count} article(s) · {ticket.payment}<br/>{ticket.site} · {ticket.cashier}</p><button className="primary" onClick={() => window.print()}>Imprimer le ticket</button></div></div>}
      {showTour&&<Tour profile={profile} step={tourStep} setStep={setTourStep} close={()=>{localStorage.setItem(`tour-${profile.username}`,'vu');setShowTour(false)}} openHelp={()=>{setShowTour(false);setView('help')}}/>}
      {helpOpen&&<HelpDrawer profile={profile} close={()=>setHelpOpen(false)} restart={()=>{setHelpOpen(false);setTourStep(0);setShowTour(true)}}/>}
    </div>
  )
}

function Login({ users, onLogin }: { users: Profile[]; onLogin: (p: Profile) => void }) {
  const [username,setUsername]=useState(''); const [password,setPassword]=useState(''); const [show,setShow]=useState(false)
  const [error,setError]=useState(''); const [pending,setPending]=useState<Profile|null>(null); const [demoOpen,setDemoOpen]=useState(false)
  const [demoTab,setDemoTab]=useState('global'); const [demoSearch,setDemoSearch]=useState('')
  function submit(e:React.FormEvent){e.preventDefault();const user=users.find(u=>(u.username===username||u.phone===username)&&u.password===password);if(!user){setError('Identifiant ou mot de passe incorrect.');return}if(!user.active){setError('Ce compte est désactivé. Contactez votre responsable.');return}setError('');if(['manager','qualite','inventaire'].includes(user.role))setPending(user);else onLogin(user)}
  if(pending)return <div className="site-choice"><Logo/><div className="site-choice-card"><p className="eyebrow">Étape 2 sur 2</p><h1>Choisissez votre site</h1><p>Vous pourrez changer de site depuis votre espace.</p><div className="site-choice-grid">{pending.role==='manager'&&<button onClick={()=>onLogin(pending)}><LayoutDashboard/><span><b>Tous les sites</b><small>Vue consolidée de l’entreprise</small></span><ChevronRight/></button>}{(pending.role==='manager'?sites:shops).map(site=><button key={site} onClick={()=>onLogin({...pending,site})}><Store/><span><b>{site}</b><small>Accéder aux données du site</small></span><ChevronRight/></button>)}</div><button className="back-link" onClick={()=>setPending(null)}>Retour à la connexion</button></div></div>
  const tabSites:Record<string,Site|undefined>={global:undefined,mc:'Magasin central',cv:'Centre-Ville',lp:'Les Palmiers',mar:'Marché'}
  const demoUsers=users.filter(u=>u.active&&(demoTab==='global'?!u.site:u.site===tabSites[demoTab])&&`${u.name} ${u.title} ${u.username}`.toLowerCase().includes(demoSearch.toLowerCase()))
  return <div className="login-page"><div className="login-brand"><Logo/><div><span className="pill">ERP + Caisse multi-sites</span><h1>La boulangerie,<br/><em>pilotée simplement.</em></h1><p>Une vue claire de vos ventes, stocks et opérations, du fournil jusqu’à chaque boutique.</p><div className="login-stats"><span><b>4</b> sites connectés</span><span><b>35</b> comptes de démonstration</span></div></div></div><div className="login-panel"><div className="login-heading"><p className="eyebrow">Connexion sécurisée</p><h2>Bienvenue</h2><p>Connectez-vous pour accéder à votre espace.</p></div><form className="login-form" onSubmit={submit}><label>Identifiant ou téléphone<input value={username} onChange={e=>setUsername(e.target.value)} placeholder="Ex. manager"/></label><label>Mot de passe<div className="password-field"><input type={show?'text':'password'} value={password} onChange={e=>setPassword(e.target.value)} placeholder="Votre mot de passe"/><button type="button" onClick={()=>setShow(!show)}>{show?'Masquer':'Afficher'}</button></div></label>{error&&<div className="form-error"><AlertTriangle size={16}/>{error}</div>}<button className="primary login-submit">Se connecter</button></form><div className="demo-accounts"><button className="demo-toggle" onClick={()=>setDemoOpen(!demoOpen)}><span>Comptes de démonstration</span><ChevronRight className={demoOpen?'rotated':''}/></button>{demoOpen&&<><div className="demo-tabs">{[['global','Direction & transversal'],['mc','Magasin central'],['cv','Centre-Ville'],['lp','Les Palmiers'],['mar','Marché']].map(t=><button className={demoTab===t[0]?'active':''} onClick={()=>setDemoTab(t[0])} key={t[0]}>{t[1]}</button>)}</div><div className="demo-search"><Search size={14}/><input value={demoSearch} onChange={e=>setDemoSearch(e.target.value)} placeholder="Rechercher un nom ou un poste…"/></div><div className="demo-list">{demoUsers.map(u=><div key={u.id}><span><b>{u.name}</b><small>{u.username} · {u.title}</small></span><button onClick={()=>{setUsername(u.username);setPassword(u.password);setError('')}}>Remplir</button></div>)}</div></>}</div></div></div>
}

function Dashboard({ profile, data, activeSite, setSite }: { profile: Profile; data: DemoData; activeSite?: Site|'Tous les sites'; setSite: (s: Site) => void }) {
  const isManager = profile.role === 'manager'
  const global=isManager&&activeSite==='Tous les sites'
  const filtered = data.tickets.filter(t => t.date === today && (global || t.site === activeSite))
  const sales = filtered.reduce((s,t) => s+t.total,0)
  const count = filtered.reduce((s,t) => s+t.count,0)
  const shopTotals = sites.map(site => ({ site, value: data.tickets.filter(t => t.date === today && t.site === site).reduce((s,t)=>s+t.total,0) }))
  const chartSites=global?shopTotals:shopTotals.filter(s=>s.site===activeSite),max = Math.max(...chartSites.map(s=>s.value), 1)
  const expenses=data.expenses.filter(e=>global||e.site===activeSite),scopeLabel=global?'Tous les sites':activeSite
  const scopeBatches=data.batches.filter(b=>global||b.site===activeSite),good=scopeBatches.reduce((s,b)=>s+(b.good||0),0),expected=scopeBatches.reduce((s,b)=>s+b.expected,0),loss=scopeBatches.reduce((s,b)=>s+(b.failed||0),0)
  return <div className="stack">
    <div className="welcome"><div><p>{new Date().toLocaleDateString('fr-FR',{weekday:'long', day:'numeric', month:'long'})}</p><h2>Bonjour {profile.name.split(' ')[0]}, voici l’essentiel.</h2></div><span className="live"><i/> Données à jour</span></div>
    <div className="kpi-grid">
      <Kpi icon={ShoppingBasket} label="Ventes du jour" value={money(sales)} note={String(scopeLabel)} tone="green"/>
      <Kpi icon={Receipt} label="Articles vendus" value={`${count}`} note={`${filtered.length} tickets`}/>
      <Kpi icon={ShoppingBasket} label="Panier moyen" value={money(filtered.length ? sales/filtered.length : 0)} note="Objectif 3 500 FCFA"/>
      <Kpi icon={WalletCards} label={isManager ? 'Solde calculé' : 'Dépenses du jour'} value={money(isManager?sales-expenses.filter(e=>e.status==='Validée').reduce((s,e)=>s+e.amount,0):expenses.reduce((s,e)=>s+e.amount,0))} note={String(scopeLabel)}/>
    </div>
    {isManager && <div className="site-cards">{shopTotals.map((s,i) => <button key={s.site} className="site-card" onClick={()=>setSite(s.site)}><span className="site-icon"><Store size={20}/></span><span><small>{i+1}e boutique</small><b>{s.site}</b></span><strong>{money(s.value)}</strong><ChevronRight size={18}/></button>)}</div>}
    <div className="dashboard-grid">
      <div className="card chart-card"><CardTitle title={global?'Performance des sites':`Performance · ${scopeLabel}`} subtitle={`Chiffre d’affaires aujourd’hui · ${scopeLabel}`}/><div className="bars">{chartSites.map(s => <div className="bar-row" key={s.site}><span>{s.site}</span><div><i style={{width:`${Math.max(12,s.value/max*100)}%`}}/></div><b>{money(s.value)}</b></div>)}</div><div className="sparkline"><svg viewBox="0 0 600 100" preserveAspectRatio="none"><path d="M0,82 C50,75 65,45 120,54 S195,82 245,52 S330,22 385,38 S445,65 490,35 S560,18 600,25"/><path className="fill" d="M0,82 C50,75 65,45 120,54 S195,82 245,52 S330,22 385,38 S445,65 490,35 S560,18 600,25 L600,100 L0,100Z"/></svg></div></div>
      <div className="card"><CardTitle title="Alertes à traiter" subtitle="Priorités opérationnelles"/><div className="alert-list"><Alert tone="red" title="2 produits à péremption J-0" site="Les Palmiers"/><Alert tone="orange" title="Stock farine sous le seuil" site="Magasin central"/><Alert tone="orange" title="2 dépenses à valider" site="Centre-Ville · Marché"/><Alert tone="green" title="Rendement fournée à 97 %" site="Atelier Boulangerie"/></div></div>
      <div className="card activity-card"><CardTitle title="Activité récente" subtitle={String(scopeLabel)}/><ActivityList items={data.activities.filter(a => global || a.site === activeSite).slice(0,5)}/></div>
      <div className="card production-card"><CardTitle title="Production du jour" subtitle={String(scopeLabel)}/><div className="production-ring"><div><b>{good}</b><span>unités produites</span></div></div><div className="mini-stats"><span><b>{expected?(good/expected*100).toFixed(1):'0'} %</b> rendement</span><span><b>{loss}</b> pertes</span></div></div>
    </div>
    <BatchList batches={data.batches.filter(b=>global||b.site===activeSite)}/>
  </div>
}

function Kpi({icon:Icon,label,value,note,tone='brown'}:{icon:typeof Store;label:string;value:string;note:string;tone?:string}) { return <div className="kpi card"><span className={`kpi-icon ${tone}`}><Icon size={20}/></span><p>{label}</p><b>{value}</b><small>{note}</small></div> }
function CardTitle({title,subtitle}:{title:string;subtitle:string}) { return <div className="card-title"><div><h3>{title}</h3><p>{subtitle}</p></div><button className="more">•••</button></div> }
function Alert({tone,title,site}:{tone:string;title:string;site:string}) { return <button className="alert-row"><span className={`alert-dot ${tone}`}><AlertTriangle size={17}/></span><span><b>{title}</b><small>{site}</small></span><ChevronRight size={17}/></button> }

function POS({site,data,cart,setCart,transact}:{site:Site;data:DemoData;cart:Record<string,number>;setCart:(c:Record<string,number>)=>void;transact:(p:string)=>void}) {
  const [search,setSearch]=useState(''); const [cat,setCat]=useState('Tous')
  const shown=products.filter(p=>p.category!=='Matières premières'&&(cat==='Tous'||p.category===cat)&&p.name.toLowerCase().includes(search.toLowerCase())&&data.stocks[site][p.id]>0)
  const total=Object.entries(cart).reduce((s,[id,q])=>s+products.find(p=>p.id===id)!.price*q,0)
  return <div className="pos-layout"><div className="catalog"><div className="search"><Search size={18}/><input placeholder="Rechercher un produit…" value={search} onChange={e=>setSearch(e.target.value)}/></div><div className="filters">{['Tous','Pains','Viennoiseries','Pâtisseries','Frais'].map(c=><button className={cat===c?'active':''} onClick={()=>setCat(c)} key={c}>{c}</button>)}</div><div className="product-grid">{shown.map(p=><button className="product" key={p.id} onClick={()=>setCart({...cart,[p.id]:(cart[p.id]||0)+1})}><span>{p.emoji}</span><b>{p.name}</b><strong>{money(p.price)}</strong><small>{data.stocks[site][p.id]} en stock</small></button>)}</div></div><div className="basket"><div className="basket-head"><div><p>Commande en cours</p><h2>{Object.values(cart).reduce((s,q)=>s+q,0)} article(s)</h2></div><button onClick={()=>setCart({})}><Trash2 size={18}/></button></div><div className="basket-items">{Object.entries(cart).filter(([,q])=>q).map(([id,q])=>{const p=products.find(x=>x.id===id)!;return <div className="basket-line" key={id}><span>{p.emoji}</span><div><b>{p.name}</b><small>{money(p.price)}</small></div><div className="stepper"><button onClick={()=>setCart({...cart,[id]:Math.max(0,q-1)})}><Minus/></button><b>{q}</b><button onClick={()=>setCart({...cart,[id]:q+1})}><Plus/></button></div></div>})}{!Object.keys(cart).some(k=>cart[k])&&<div className="empty"><ShoppingBasket/><b>Le panier est vide</b><p>Touchez un produit pour l’ajouter</p></div>}</div><div className="basket-total"><span>Total à payer</span><b>{money(total)}</b></div><div className="payment"><button onClick={()=>transact('Espèces')}>Espèces</button><button onClick={()=>transact('Mobile Money')}>Mobile Money</button><button onClick={()=>transact('Carte')}>Carte</button></div></div></div>
}

function Stock({data,setData,site,profile,toast}:{data:DemoData;setData:React.Dispatch<React.SetStateAction<DemoData>>;site:Site;profile:Profile;toast:(s:string)=>void}) { const [q,setQ]=useState('');const [open,setOpen]=useState(false);const [productId,setProductId]=useState('farine');const [qty,setQty]=useState('');const [supplier,setSupplier]=useState('Moulins du Bénin');function enter(){if(!Number(qty))return;setData(d=>({...d,stocks:{...d.stocks,[site]:{...d.stocks[site],[productId]:(d.stocks[site][productId]||0)+Number(qty)}},activities:[{id:`a-${Date.now()}`,text:`Entrée de ${qty} ${productId==='farine'?'kg':'unités'} · ${products.find(p=>p.id===productId)?.name}`,site,user:profile.name,time:'À l’instant',kind:'Stock'},...d.activities]}));setOpen(false);setQty('');toast('Entrée enregistrée · stock du site mis à jour')}return <div className="card table-card"><div className="list-toolbar"><div><h2>Stock · {site}</h2><p>{products.length} références actives</p></div><div className="toolbar-actions">{profile.role==='magasinier'&&<button className="primary" onClick={()=>setOpen(true)}><Plus size={16}/> Nouvelle entrée</button>}<div className="search"><Search size={18}/><input placeholder="Rechercher…" value={q} onChange={e=>setQ(e.target.value)}/></div></div></div><div className="table"><div className="tr th"><span>Produit</span><span>Catégorie</span><span>Quantité</span><span>Prix unitaire</span><span>Valeur</span><span>État</span></div>{products.filter(p=>p.name.toLowerCase().includes(q.toLowerCase())).map(p=>{const amount=data.stocks[site][p.id]||0;const unit=p.id==='farine'||p.category==='Matières premières'?'kg':'unités';return <div className="tr" key={p.id}><span className="product-name"><i>{p.emoji}</i><b>{p.name}</b></span><span>{p.category}</span><span><b>{amount}</b> {unit}</span><span>{money(p.price)}</span><span><b>{money(p.price*amount)}</b></span><span><em className={amount<40?'badge warn':'badge ok'}>{amount<40?'Stock bas':'Disponible'}</em></span></div>})}</div>{open&&<div className="modal-backdrop"><div className="form-modal"><div className="modal-heading"><div><p className="eyebrow">Stock du {site}</p><h2>Nouvelle entrée</h2></div><button onClick={()=>setOpen(false)}><X/></button></div><div className="form-grid"><label>Fournisseur<input value={supplier} onChange={e=>setSupplier(e.target.value)}/></label><label>Produit<select value={productId} onChange={e=>setProductId(e.target.value)}>{products.filter(p=>p.category==='Matières premières').map(p=><option value={p.id} key={p.id}>{p.name}</option>)}</select></label><label>Quantité<input type="number" min="0" value={qty} onChange={e=>setQty(e.target.value)} placeholder="Ex. 100"/></label><label>Unité<input disabled value={productId==='farine'?'kg':'unité de stock'}/></label></div><div className="modal-actions"><button className="outline" onClick={()=>setOpen(false)}>Annuler</button><button className="primary" disabled={!Number(qty)} onClick={enter}>Enregistrer l’entrée</button></div></div></div>}</div> }
function Tickets({tickets}:{tickets:Ticket[]}) { return <div className="card table-card"><div className="list-toolbar"><div><h2>Tickets du jour</h2><p>{tickets.length} opérations</p></div></div><div className="table"><div className="tr th"><span>N° ticket</span><span>Heure / date</span><span>Boutique</span><span>Articles</span><span>Paiement</span><span>Total</span></div>{tickets.map(t=><div className="tr" key={t.id}><span><b>{t.id}</b></span><span>{t.date}</span><span>{t.site}</span><span>{t.count}</span><span><em className="badge neutral">{t.payment}</em></span><span><b>{money(t.total)}</b></span></div>)}</div></div> }
function ActivityList({items}:{items:Activity[]}) { return <div className="activity-list">{items.map(a=><div className="activity" key={a.id}><span>{a.kind==='Production'?<Wheat size={17}/>:<Receipt size={16}/>}</span><div><b>{a.text}</b><p>{a.user} · {a.site}</p></div><small>{a.time}</small></div>)}{!items.length&&<div className="empty"><Receipt/><b>Aucune activité</b></div>}</div> }
function Treasury({data,totalSales}:{data:DemoData;totalSales:number}) { return <div className="stack"><div className="kpi-grid"><Kpi icon={WalletCards} label="Entrées du jour" value={money(totalSales)} note="Ventes encaissées" tone="green"/><Kpi icon={Receipt} label="Dépenses" value={money(data.expenses.reduce((s,e)=>s+e.amount,0))} note="Toutes catégories"/></div><div className="card table-card"><CardTitle title="Dépenses récentes" subtitle="Demandes et validations"/><div className="table">{data.expenses.map((e,i)=><div className="tr expense" key={i}><span><b>{e.label}</b></span><span>{e.site}</span><span><b>{money(e.amount)}</b></span><span><em className={e.status==='Validée'?'badge ok':'badge warn'}>{e.status}</em></span></div>)}</div></div></div> }
function Requests({data,setData,toast,profile}:{data:DemoData;setData:React.Dispatch<React.SetStateAction<DemoData>>;toast:(s:string)=>void;profile:Profile}) {
  const central=profile.site==='Magasin central';const [open,setOpen]=useState(false);const [selected,setSelected]=useState<SupplyRequest|null>(null);const [type,setType]=useState('Matières premières');const [urgency,setUrgency]=useState('Normal');const [comment,setComment]=useState('');const [lines,setLines]=useState<RequestLine[]>([{productId:'bag',qty:1}]);const visible=central?data.requests:data.requests.filter(r=>r.site===profile.site)
  function create(){const req:SupplyRequest={id:`R-${Date.now().toString().slice(-4)}`,site:profile.site!,requester:profile.name,date:new Date().toLocaleString('fr-FR'),type,urgency,comment,lines,status:'En attente'};setData(d=>({...d,requests:[req,...d.requests],activities:[{id:`a-${Date.now()}`,text:`Demande de réapprovisionnement ${req.id}`,site:req.site,user:profile.name,time:'À l’instant',kind:'Stock'},...d.activities]}));setOpen(false);toast('Demande envoyée au Magasin central')}
  function status(req:SupplyRequest,next:string){if(next==='Refusée'){const reason=prompt('Motif du refus (obligatoire)');if(!reason)return;req={...req,refusal:reason}}setData(d=>({...d,requests:d.requests.map(r=>r.id===req.id?{...req,status:next,lines:next==='Acceptée'?req.lines.map(l=>({...l,delivered:l.qty})):req.lines}:r),activities:[{id:`a-${Date.now()}`,text:`Demande ${req.id} : ${next}`,site:req.site,user:profile.name,time:'À l’instant',kind:'Stock'},...d.activities]}));setSelected(null);toast(next==='Acceptée'?'Transfert créé · bordereau disponible':`Demande ${next.toLowerCase()}`)}
  function receive(req:SupplyRequest){setData(d=>{const dest={...d.stocks[req.site]},source={...d.stocks['Magasin central']};req.lines.forEach(l=>{const qty=l.delivered||l.qty;source[l.productId]=Math.max(0,(source[l.productId]||0)-qty);dest[l.productId]=(dest[l.productId]||0)+qty});return{...d,stocks:{...d.stocks,'Magasin central':source,[req.site]:dest},requests:d.requests.map(r=>r.id===req.id?{...r,status:'Reçue'}:r),activities:[{id:`a-${Date.now()}`,text:`Réception confirmée ${req.id}`,site:req.site,user:profile.name,time:'À l’instant',kind:'Stock'},...d.activities]}});toast('Réception confirmée · stock mis à jour')}
  return <div className="card table-card"><div className="list-toolbar"><div><h2>Demandes de réapprovisionnement</h2><p>Les boutiques demandent ici des produits au Magasin central. Acceptez, ajustez ou refusez chaque demande.</p></div>{!central&&<button className="primary" onClick={()=>setOpen(true)}><Plus size={16}/> Nouvelle demande</button>}</div>{visible.map(r=><div className="supply-request" key={r.id}><div className="request-summary"><span className="site-icon"><ArrowLeftRight/></span><div><b>{r.site} · {r.requester}</b><p>{r.id} · {r.date} · {r.type}</p></div>{r.urgency==='Urgent'&&<em className="badge danger">Urgent</em>}<em className={r.status==='En attente'?'badge warn':'badge ok'}>{r.status}</em></div><div className="request-lines">{r.lines.map(l=>{const p=products.find(p=>p.id===l.productId)!;const available=data.stocks['Magasin central'][l.productId]||0;return <div key={l.productId}><span>{p?.name||l.productId}</span><b>{l.qty} demandés</b>{central&&<small className={available<l.qty?'insufficient':''}>Stock central : {available}</small>}</div>})}</div>{r.comment&&<p className="request-comment">{r.comment}</p>}<div className="request-actions">{central&&r.status==='En attente'&&<><button className="primary small" onClick={()=>setSelected(r)}>Accepter / ajuster</button><button className="outline danger" onClick={()=>status(r,'Refusée')}>Refuser</button></>}{central&&r.status==='Acceptée'&&<button className="primary small" onClick={()=>status(r,'En livraison')}>Expédier</button>}{!central&&r.status==='En livraison'&&<button className="primary small" onClick={()=>receive(r)}>Réception confirmée</button>}</div></div>)}{open&&<div className="modal-backdrop"><div className="form-modal"><div className="modal-heading"><h2>Nouvelle demande</h2><button onClick={()=>setOpen(false)}><X/></button></div><div className="form-grid"><label>Type<select value={type} onChange={e=>setType(e.target.value)}><option>Matières premières</option><option>Dépannage produits finis</option></select></label><label>Urgence<select value={urgency} onChange={e=>setUrgency(e.target.value)}><option>Normal</option><option>Urgent</option></select></label></div>{lines.map((l,i)=><div className="dynamic-line" key={i}><select value={l.productId} onChange={e=>setLines(lines.map((x,j)=>j===i?{...x,productId:e.target.value}:x))}>{products.map(p=><option value={p.id} key={p.id}>{p.name}</option>)}</select><input type="number" min="1" value={l.qty} onChange={e=>setLines(lines.map((x,j)=>j===i?{...x,qty:Number(e.target.value)}:x))}/></div>)}<button className="outline" onClick={()=>setLines([...lines,{productId:'bag',qty:1}])}>+ Ajouter une ligne</button><label className="block-label">Commentaire<textarea className="production-note" value={comment} onChange={e=>setComment(e.target.value)}/></label><div className="modal-actions"><button className="outline" onClick={()=>setOpen(false)}>Annuler</button><button className="primary" onClick={create}>Envoyer</button></div></div></div>}{selected&&<div className="modal-backdrop"><div className="form-modal"><div className="modal-heading"><h2>Ajuster la livraison · {selected.id}</h2><button onClick={()=>setSelected(null)}><X/></button></div>{selected.lines.map((l,i)=><div className="dynamic-line" key={l.productId}><b>{products.find(p=>p.id===l.productId)?.name}</b><input type="number" value={l.delivered??l.qty} max={data.stocks['Magasin central'][l.productId]} onChange={e=>setSelected({...selected,lines:selected.lines.map((x,j)=>j===i?{...x,delivered:Number(e.target.value)}:x)})}/></div>)}<div className="modal-actions"><button className="outline" onClick={()=>setSelected(null)}>Annuler</button><button className="primary" onClick={()=>status(selected,'Acceptée')}>Valider et générer le bordereau</button></div></div></div>}</div>
}
function Production({toast,data,setData,profile}:{toast:(s:string)=>void;data:DemoData;setData:React.Dispatch<React.SetStateAction<DemoData>>;profile:Profile}) {
  const site=profile.site||'Magasin central', isOven=profile.username.startsWith('enfourneur.'), isBaker=profile.username.startsWith('boulanger.')
  const [selected,setSelected]=useState<string|null>(null), [flour,setFlour]=useState('50'), [value,setValue]=useState(''), [failed,setFailed]=useState(''), [note,setNote]=useState(''), [confirm,setConfirm]=useState(false), [distribution,setDistribution]=useState(''), [stockError,setStockError]=useState(false)
  const ownWorkshop=profile.username.startsWith('patissier.')?'Pâtisserie':profile.username.startsWith('yaourt.')?'Yaourt':profile.username.startsWith('glace.')?'Crème glacée':profile.role==='production'?'Boulangerie':null
  const batches=data.batches.filter(b=>b.site===site&&(!ownWorkshop||b.workshop===ownWorkshop)), batch=batches.find(b=>b.id===selected), expected=Math.round(Number(flour)*3.72)
  function log(text:string){return {id:`a-${Date.now()}-${Math.random()}`,text,site,user:profile.name,time:'À l’instant',kind:'Production'}}
  function create(){const kg=Number(flour);if(!kg)return;if((data.stocks[site].farine||0)<kg){setStockError(true);return}setStockError(false);const id=`F-${site.replace(/[^A-Z]/g,'').slice(0,2)||'CV'}-${Date.now().toString().slice(-4)}`,at=new Date().toLocaleString('fr-FR');const b:Batch={id,site,workshop:'Boulangerie',product:'Baguette',flour:kg,ingredients:{farine:kg,levure:+(kg*.02).toFixed(1),sel:+(kg*.018).toFixed(1),eau:+(kg*.62).toFixed(1)},expected,status:'En pétrissage',createdBy:profile.name,createdDate:new Date().toISOString().slice(0,10),steps:[{label:'En pétrissage',user:profile.name,at}]};setData(d=>({...d,stocks:{...d.stocks,[site]:{...d.stocks[site],farine:d.stocks[site].farine-kg}},batches:[b,...d.batches],activities:[log(`Fournée ${id} créée · ${kg} kg de farine`),...d.activities]}));setSelected(id);toast('Fournée créée · matières premières déduites')}
  function alertStorekeeper(){const req:SupplyRequest={id:`R-${Date.now().toString().slice(-4)}`,site,requester:profile.name,date:new Date().toLocaleString('fr-FR'),type:'Matières premières',urgency:'Urgent',comment:`Farine nécessaire pour une fournée de ${flour} kg`,lines:[{productId:'farine',qty:Number(flour)}],status:'En attente'};setData(d=>({...d,requests:[req,...d.requests],activities:[log(`Alerte stock farine envoyée au magasinier · ${req.id}`),...d.activities]}));toast('Magasinier prévenu · demande pré-remplie créée')}
  function declareDough(){if(!batch||!Number(value))return;const at=new Date().toLocaleString('fr-FR'),modified=batch.status==='En attente de cuisson';setData(d=>({...d,batches:d.batches.map(b=>b.id===batch.id?{...b,dough:Number(value),note,status:'En attente de cuisson',steps:[...b.steps.filter(s=>s.label!=='En attente de cuisson'),{label:'En attente de cuisson',user:profile.name,at}]}:b),activities:[log(`${modified?'Déclaration modifiée':'Pâtons déclarés'} · ${batch.id} · ${value}/${batch.expected}`),...d.activities]}));setConfirm(false);setValue('');toast('Fournée transmise à l’Enfourneur')}
  function startOven(b:Batch){const at=new Date().toLocaleString('fr-FR');setData(d=>({...d,batches:d.batches.map(x=>x.id===b.id?{...x,status:'En cuisson',ovenBy:profile.name,steps:[...x.steps,{label:'En cuisson',user:profile.name,at}]}:x),activities:[log(`Cuisson démarrée · ${b.id}`),...d.activities]}));setSelected(b.id);toast('Cuisson démarrée · minuteur 22 min')}
  function finishOven(){if(!batch||!Number(value)||Number(value)+Number(failed)>Number(batch.dough)){toast('Le total bons + ratés dépasse les pâtons reçus');return}const at=new Date().toLocaleString('fr-FR');setData(d=>({...d,batches:d.batches.map(b=>b.id===batch.id?{...b,good:Number(value),failed:Number(failed)||0,failureReason:note,status:'Cuite',steps:[...b.steps,{label:'Cuite',user:profile.name,at}]}:b),activities:[log(`Cuisson terminée · ${batch.id} · ${value} bons, ${failed||0} ratés`),...d.activities]}));setValue('');setFailed('');setNote('');toast('Sortie du four enregistrée')}
  function distribute(){if(!batch||!Number(distribution)||Number(distribution)>Number(batch.good)){toast('La répartition dépasse les pains disponibles');return}const qty=Number(distribution),at=new Date().toLocaleString('fr-FR');setData(d=>({...d,stocks:{...d.stocks,[site]:{...d.stocks[site],bag:(d.stocks[site].bag||0)+qty}},batches:d.batches.map(b=>b.id===batch.id?{...b,distributed:qty,destination:`Boutique ${site}`,status:'Distribuée',steps:[...b.steps,{label:'Distribuée',user:profile.name,at}]}:b),activities:[log(`${qty} baguettes distribuées · ${batch.id} · bordereau généré`),...d.activities]}));setDistribution('');toast('Distribution validée · stock caisse augmenté')}
  if(!isBaker&&!isOven&&ownWorkshop)return <WorkshopScreen workshop={ownWorkshop} site={site} data={data} setData={setData} profile={profile} toast={toast}/>
  if(!isBaker&&!isOven)return <WorkshopTabs site={site} data={data} setData={setData} profile={profile} toast={toast}/>
  const editable=batch&&(batch.status==='En pétrissage'||batch.status==='En attente de cuisson')
  const currentRate=batch?.good?batch.good/batch.expected*100:Number(value)&&batch?Number(value)/batch.expected*100:0, tone=currentRate>=95?'good':currentRate>=85?'medium':'bad'
  return <div className="stack"><div className="workshop-hero"><div><span className="pill">{isOven?'Poste Enfourneur':'Poste Boulanger'} · {site}</span><h2>Fournées du jour</h2><p>Une fiche unique, du pétrissage à la distribution</p></div><Wheat size={48}/></div>{isBaker&&<div className="card production-entry"><h2>Nouvelle fournée</h2><div className="form-grid"><label>Recette<select><option>Baguette</option></select></label><label>Farine utilisée (kg)<input type="number" value={flour} onChange={e=>{setFlour(e.target.value);setStockError(false)}}/></label></div><div className="ingredients"><span>Levure <b>{(Number(flour)*.02).toFixed(1)} kg</b></span><span>Sel <b>{(Number(flour)*.018).toFixed(1)} kg</b></span><span>Eau <b>{(Number(flour)*.62).toFixed(1)} L</b></span></div><p className="expected">Pâtons attendus : <b>{expected}</b> · Farine disponible : {data.stocks[site].farine||0} kg</p>{stockError&&<div className="stock-error"><AlertTriangle/><span>Stock insuffisant : {data.stocks[site].farine||0} kg de farine disponible au {site}. Il faut {flour} kg.</span><button onClick={alertStorekeeper}>Prévenir le magasinier</button></div>}<button className="primary" onClick={create}>Créer la fournée</button></div>}<BatchList batches={batches} selected={selected} onSelect={setSelected} onStart={isOven?startOven:undefined}/>{batch&&<div className="card production-entry"><BatchStepper batch={batch}/>{isBaker&&editable&&<><p className="expected">Pâtons attendus : <b>{batch.expected}</b></p><NumberPad value={value} setValue={setValue}/>{value&&<div className={`live-result ${tone}`}>{value} / {batch.expected} · écart {Number(value)-batch.expected} · {(Number(value)/batch.expected*100).toFixed(1)} %</div>}<label>Remarque<textarea className="production-note" value={note} onChange={e=>setNote(e.target.value)}/></label><button className="primary giant" disabled={!Number(value)} onClick={()=>setConfirm(true)}>{batch.dough?'Corriger la déclaration':'Valider les pâtons'}</button></>}{isOven&&batch.status==='En cuisson'&&<><p className="expected">Pâtons reçus : <b>{batch.dough}</b></p><label>Pains bons</label><NumberPad value={value} setValue={setValue}/><label>Pains ratés<input className="production-note" type="number" value={failed} onChange={e=>setFailed(e.target.value)} placeholder="0"/></label><label>Motif / remarque<textarea className="production-note" value={note} onChange={e=>setNote(e.target.value)}/></label>{Number(batch.dough)-(Number(value)||0)-(Number(failed)||0)>0&&<div className="live-result medium">{Number(batch.dough)-(Number(value)||0)-(Number(failed)||0)} pain(s) non justifié(s)</div>}<button className="primary giant" disabled={!Number(value)} onClick={finishOven}>Valider la sortie du four</button></>}{isOven&&batch.status==='Cuite'&&<><p className="expected">Pains bons disponibles : <b>{batch.good}</b></p><label>Quantité vers Boutique {site}<input className="production-note" type="number" value={distribution} onChange={e=>setDistribution(e.target.value)} placeholder="0"/></label><button className="primary giant" onClick={distribute}>Distribuer et générer le bordereau</button></>}</div>}{confirm&&<div className="modal-backdrop"><div className="ticket-modal"><Wheat className="ticket-logo"/><h2>Confirmer {value} pâtons ?</h2><p>{batch?.id} · {profile.name} · {site}</p><div className="modal-actions"><button className="outline" onClick={()=>setConfirm(false)}>Corriger</button><button className="primary" onClick={declareDough}>Confirmer</button></div></div></div>}</div>
}
function NumberPad({value,setValue}:{value:string;setValue:(v:string)=>void}){const adjust=(n:number)=>setValue(String(Math.max(0,(Number(value)||0)+n)));return <div className="number-pad"><button onClick={()=>adjust(-10)}>−10</button><button onClick={()=>adjust(-1)}>−1</button><input type="number" inputMode="numeric" placeholder="0" value={value} onChange={e=>setValue(e.target.value)}/><button onClick={()=>adjust(1)}>+1</button><button onClick={()=>adjust(10)}>+10</button></div>}
function BatchStepper({batch}:{batch:Batch}){const labels=['En pétrissage','En attente de cuisson','En cuisson','Cuite','Distribuée'],active=labels.indexOf(batch.status);return <div className="batch-stepper">{labels.map((l,i)=>{const step=batch.steps.find(s=>s.label===l);return <div className={i<=active?'done':''} key={l}><span>{i<active?'✓':i+1}</span><b>{l}</b><small>{step?`${step.user} · ${step.at}`:'En attente'}</small></div>})}</div>}
function BatchList({batches,selected,onSelect,onStart}:{batches:Batch[];selected?:string|null;onSelect?:(id:string)=>void;onStart?:(b:Batch)=>void}){return <div className="card table-card"><CardTitle title="Fournées du site" subtitle={`${batches.length} fiche(s) en temps réel`}/>{batches.length===0&&<div className="empty"><Wheat/><b>Aucune fournée aujourd’hui</b></div>}{batches.map(b=>{const global=b.good?b.good/b.expected*100:b.dough?b.dough/b.expected*100:0;return <div className={`batch-row ${selected===b.id?'selected':''}`} key={b.id} onClick={()=>onSelect?.(b.id)}><span className="site-icon"><Wheat/></span><div><b>{b.id} · {b.product}</b><p>{b.createdBy} · {b.flour} kg farine · {b.dough||'—'} pâtons</p></div><em className="badge neutral">{b.status}</em><div className="batch-loss"><small>Pétrissage</small><b>{b.dough!==undefined?b.expected-b.dough:'—'}</b></div><div className="batch-loss"><small>Cuisson</small><b>{b.good!==undefined?(b.dough||0)-b.good:'—'}</b></div><strong className={global>=95?'rate good':global>=85?'rate medium':'rate bad'}>{global?`${global.toFixed(1)} %`:'—'}</strong>{onStart&&b.status==='En attente de cuisson'&&<button className="primary small" onClick={e=>{e.stopPropagation();onStart(b)}}>Démarrer la cuisson</button>}</div>})}</div>}
function ProductionReport({batches,site,activities}:{batches:Batch[];site:Site;activities:Activity[]}){
  const [date,setDate]=useState(new Date().toISOString().slice(0,10)),[status,setStatus]=useState('Tous'),[workshop,setWorkshop]=useState('Tous'),[person,setPerson]=useState(''),[selected,setSelected]=useState<Batch|null>(null)
  const day=batches.filter(b=>(b.createdDate||new Date().toISOString().slice(0,10))===date&&(status==='Tous'||b.status===status)&&(workshop==='Tous'||b.workshop===workshop)&&(!person||`${b.createdBy} ${b.ovenBy||''}`.toLowerCase().includes(person.toLowerCase())))
  const totals=day.reduce((a,b)=>({flour:a.flour+b.flour,expected:a.expected+b.expected,dough:a.dough+(b.dough||0),good:a.good+(b.good||0),failed:a.failed+(b.failed||0),distributed:a.distributed+(b.distributed||0)}),{flour:0,expected:0,dough:0,good:0,failed:0,distributed:0})
  const rate=totals.expected?totals.good/totals.expected*100:0, rawCost=day.reduce((s,b)=>s+Object.entries(b.ingredients).reduce((x,[id,q])=>x+q*(products.find(p=>p.id===id)?.price||0),0),0)
  function move(n:number){const d=new Date(`${date}T12:00:00`);d.setDate(d.getDate()+n);setDate(d.toISOString().slice(0,10))}
  return <div className="stack"><div className="production-toolbar"><div><p className="eyebrow">Suivi de production</p><h2>{site}</h2></div><div className="date-picker"><button onClick={()=>move(-1)}>‹</button><input type="date" value={date} onChange={e=>setDate(e.target.value)}/><button onClick={()=>move(1)}>›</button></div><button className="primary" onClick={()=>window.print()}>Imprimer le rapport du jour</button><button className="outline" onClick={()=>alert('Export Excel généré (simulation)')}>Exporter Excel</button></div><div className="production-filters"><select value={workshop} onChange={e=>setWorkshop(e.target.value)}><option>Tous</option><option>Boulangerie</option><option>Pâtisserie</option><option>Yaourt</option><option>Crème glacée</option></select><select value={status} onChange={e=>setStatus(e.target.value)}><option>Tous</option>{['En pétrissage','En attente de cuisson','En cuisson','Cuite','Distribuée'].map(s=><option key={s}>{s}</option>)}</select><input placeholder="Boulanger ou enfourneur…" value={person} onChange={e=>setPerson(e.target.value)}/></div><div className="production-kpis"><Kpi icon={Factory} label="Fournées" value={`${day.length}`} note="Sur la journée"/><Kpi icon={Wheat} label="Farine consommée" value={`${totals.flour} kg`} note={money(rawCost)}/><Kpi icon={TrendingUp} label="Pâtons" value={`${totals.dough} / ${totals.expected}`} note={`${totals.expected-totals.dough} pertes`}/><Kpi icon={PackageCheck} label="Pains bons / ratés" value={`${totals.good} / ${totals.failed}`} note={`${totals.distributed} distribués`}/><Kpi icon={BarChart3} label="Rendement global" value={`${rate.toFixed(1)} %`} note={`Pertes : ${money((totals.expected-totals.good)*150)}`}/></div><div className="card production-table"><div className="production-tr head"><span>N° / recette</span><span>Statut</span><span>Création</span><span>Équipe</span><span>Farine</span><span>Pâtons</span><span>Pains bons</span><span>Rendement</span></div>{day.map(b=>{const r=b.good?b.good/b.expected*100:0;return <button className="production-tr" key={b.id} onClick={()=>setSelected(b)}><span><b>{b.id}</b><small>{b.product} · {b.workshop}</small></span><span><em className="badge neutral">{b.status}</em></span><span>{b.steps[0]?.at||'—'}</span><span><b>{b.createdBy}</b><small>{b.ovenBy||'Enfourneur en attente'}</small></span><span>{b.flour} kg</span><span>{b.dough||'—'} / {b.expected}</span><span>{b.good??'—'}</span><span className={r>=95?'rate good':r>=85?'rate medium':'rate bad'}>{r?`${r.toFixed(1)} %`:'—'}</span></button>})}{!day.length&&<div className="empty"><Factory/><b>Aucune fournée pour cette date</b></div>}</div>{selected&&<BatchDetail batch={selected} activities={activities.filter(a=>a.site===site&&a.text.includes(selected.id))} onClose={()=>setSelected(null)}/>}</div>
}
function BatchDetail({batch,activities,onClose}:{batch:Batch;activities:Activity[];onClose:()=>void}){const raw=Object.entries(batch.ingredients),cost=raw.reduce((s,[id,q])=>s+q*(products.find(p=>p.id===id)?.price||0),0),rate=batch.good?batch.good/batch.expected*100:0;return <div className="modal-backdrop batch-modal"><div className="batch-detail"><div className="modal-heading"><div><p className="eyebrow">Fiche de fournée</p><h2>{batch.id} · {batch.product}</h2><p>{batch.site} · {batch.status}</p></div><button onClick={onClose}><X/></button></div><BatchStepper batch={batch}/><div className="detail-grid"><section><h3>Matières premières consommées</h3>{raw.map(([id,q])=>{const p=products.find(x=>x.id===id),price=p?.price||0;return <div className="detail-line" key={id}><span>{p?.name||id}</span><span>Prévu {q} · Réel {q} · Écart 0</span><b>{money(q*price)}</b></div>})}<div className="detail-total"><span>Coût matières</span><b>{money(cost)}</b></div></section><section><h3>Pétrissage</h3><div className="metrics"><span>Attendus <b>{batch.expected}</b></span><span>Obtenus <b>{batch.dough||'—'}</b></span><span>Perte <b>{batch.dough!==undefined?batch.expected-batch.dough:'—'}</b></span></div><p>{batch.note||'Aucune remarque du Boulanger'}</p><h3>Cuisson</h3><div className="metrics"><span>Pâtons cuits <b>{batch.dough||'—'}</b></span><span>Pains bons <b>{batch.good??'—'}</b></span><span>Ratés <b>{batch.failed??'—'}</b></span></div><p>{batch.failureReason||'Aucun motif renseigné'}</p></section><section><h3>Rendements et coûts</h3><div className="metrics"><span>Perte pétrissage <b>{batch.dough!==undefined?batch.expected-batch.dough:'—'}</b></span><span>Perte cuisson <b>{batch.good!==undefined?(batch.dough||0)-batch.good:'—'}</b></span><span>Global <b className={rate>=95?'rate good':rate>=85?'rate medium':'rate bad'}>{rate?`${rate.toFixed(1)} %`:'—'}</b></span><span>Coût / pain <b>{batch.good?money(cost/batch.good):'—'}</b></span></div></section><section><h3>Distribution</h3>{batch.distributed?<div className="detail-line"><span>{batch.destination}</span><b>{batch.distributed} pains</b><button onClick={()=>window.print()}>BL-{batch.id}</button><em className="badge ok">Réceptionnée</em></div>:<p>Aucune distribution enregistrée.</p>}<h3>Historique des modifications</h3>{activities.map(a=><div className="history" key={a.id}><Wheat/><span><b>{a.text}</b><small>{a.user} · {a.time}</small></span></div>)}</section></div><div className="modal-actions"><button className="outline" onClick={onClose}>Fermer</button><button className="primary" onClick={()=>window.print()}>Imprimer la fiche de fournée</button></div></div></div>}
type WorkshopName='Pâtisserie'|'Yaourt'|'Crème glacée'
const workshopConfig:Record<WorkshopName,{item:string;unit:string;input:string;actual:string;loss:string;search:string;recipes:string[];steps:string[];material:string;ingredients:Record<string,number>}>={
  'Pâtisserie':{item:'Préparations',unit:'pièces',input:'Matières consommées',actual:'Pièces réellement obtenues',loss:'Pièces ratées',search:'Rechercher une préparation ou un pâtissier…',recipes:['Croissant','Chocolatine','Tartelette','Gâteau d’anniversaire','Beignet'],steps:['Préparation','Cuisson','Finition / décoration','Distribution'],material:'Farine, beurre, sucre et œufs',ingredients:{farine:12,beurre:4,'sucre-mp':3,oeufs:60}},
  'Yaourt':{item:'Lots',unit:'pots',input:'Lait et ferments utilisés',actual:'Pots réellement conditionnés',loss:'Pots non conformes',search:'Rechercher un lot…',recipes:['Yaourt nature 125 ml','Yaourt sucré 500 ml','Yaourt fraise 125 ml','Yaourt vanille 1 L'],steps:['Préparation du lait','Ensemencement','Fermentation · 6 h · 42 °C','Conditionnement en pots','Distribution'],material:'Lait, sucre et ferments',ingredients:{lait:40,'sucre-mp':5,levure:1}},
  'Crème glacée':{item:'Lots',unit:'pots / bacs',input:'Mix et ingrédients utilisés',actual:'Pots / bacs réellement obtenus',loss:'Pertes de conditionnement',search:'Rechercher un lot…',recipes:['Vanille · pot 100 ml','Chocolat · pot 500 ml','Coco · bac 5 L','Fraise · pot 100 ml'],steps:['Préparation du mix','Maturation','Turbinage','Mise en pots / bacs','Congélation','Distribution'],material:'Lait, crème, sucre et arômes',ingredients:{lait:25,beurre:5,'sucre-mp':6}},
}
function WorkshopTabs({site,data,setData,profile,toast}:{site:Site;data:DemoData;setData:React.Dispatch<React.SetStateAction<DemoData>>;profile:Profile;toast:(s:string)=>void}){const [tab,setTab]=useState<'Boulangerie'|WorkshopName>('Boulangerie');return <div className="stack"><div className="workshop-tabs">{(['Boulangerie','Pâtisserie','Yaourt','Crème glacée'] as const).map(t=><button className={tab===t?'active':''} onClick={()=>setTab(t)} key={t}>{t}</button>)}</div>{tab==='Boulangerie'?<ProductionReport batches={data.batches.filter(b=>b.site===site&&b.workshop==='Boulangerie')} site={site} activities={data.activities}/>:<WorkshopScreen workshop={tab} site={site} data={data} setData={setData} profile={profile} toast={toast}/>}</div>}
function WorkshopScreen({workshop,site,data,setData,profile,toast}:{workshop:WorkshopName;site:Site;data:DemoData;setData:React.Dispatch<React.SetStateAction<DemoData>>;profile:Profile;toast:(s:string)=>void}){
  const c=workshopConfig[workshop],[recipe,setRecipe]=useState(c.recipes[0]),[expected,setExpected]=useState('100'),[actual,setActual]=useState(''),[rejected,setRejected]=useState(''),[note,setNote]=useState(''),[search,setSearch]=useState('')
  const records=data.batches.filter(b=>b.site===site&&b.workshop===workshop),number=Number(actual),target=Number(expected),rate=target?number/target*100:0,cost=Object.entries(c.ingredients).reduce((s,[id,q])=>s+q*(products.find(p=>p.id===id)?.price||0),0)
  function save(){if(!number)return;const id=`${workshop==='Pâtisserie'?'PAT':workshop==='Yaourt'?'YAO':'GLA'}-${Date.now().toString().slice(-5)}`,at=new Date().toLocaleString('fr-FR'),b:Batch={id,site,workshop,product:recipe,flour:0,ingredients:c.ingredients,expected:target,dough:number,good:Math.max(0,number-Number(rejected)),failed:Number(rejected)||0,note,status:'Distribuée',createdBy:profile.name,createdDate:new Date().toISOString().slice(0,10),steps:c.steps.map(label=>({label,user:profile.name,at}))};setData(d=>({...d,batches:[b,...d.batches],activities:[{id:`a-${Date.now()}`,text:`${c.item.slice(0,-1)} ${id} validé · ${number} ${c.unit}`,site,user:profile.name,time:'À l’instant',kind:'Production'},...d.activities]}));setActual('');setRejected('');setNote('');toast(`${c.item.slice(0,-1)} enregistré avec les quantités réelles`)}
  const totalActual=records.reduce((s,b)=>s+(b.dough||0),0),totalGood=records.reduce((s,b)=>s+(b.good||0),0),totalBad=records.reduce((s,b)=>s+(b.failed||0),0),totalExpected=records.reduce((s,b)=>s+b.expected,0)
  return <div className="stack workshop-specific"><div className="workshop-hero"><div><span className="pill">Atelier {workshop} · {site}</span><h2>{c.item} du jour</h2><p>{c.steps.join(' → ')}</p></div><Factory size={44}/></div><div className="workshop-kpis"><Kpi icon={Factory} label={`${c.item} du jour`} value={`${records.length}`} note={site}/><Kpi icon={Boxes} label={c.input} value={workshop==='Yaourt'?`${records.length*40} L`:workshop==='Crème glacée'?`${records.length*25} L`:money(records.length*cost)} note={`${c.material} · ${money(records.length*cost)}`}/><Kpi icon={PackageCheck} label={`Attendus / obtenus`} value={`${totalExpected} / ${totalActual}`} note={c.unit}/><Kpi icon={AlertTriangle} label={c.loss} value={`${totalBad}`} note={c.unit}/><Kpi icon={TrendingUp} label="Rendement" value={`${totalExpected?(totalGood/totalExpected*100).toFixed(1):'0'} %`} note="Calculé sur les quantités réelles"/></div><div className="card workshop-form"><h3>Nouveau {workshop==='Pâtisserie'?'cycle de préparation':'lot'}</h3><div className="form-grid"><label>Recette / format<select value={recipe} onChange={e=>setRecipe(e.target.value)}>{c.recipes.map(r=><option key={r}>{r}</option>)}</select></label><label>Quantité attendue<input type="number" value={expected} onChange={e=>setExpected(e.target.value)}/></label></div><div className="workshop-steps">{c.steps.map((s,i)=><span key={s}><b>{i+1}</b>{s}</span>)}</div><label>{c.actual}</label><NumberPad value={actual} setValue={setActual}/>{actual&&<div className={`live-result ${rate>=95?'good':rate>=85?'medium':'bad'}`}>{actual} / {expected} · écart {number-target} · {rate.toFixed(1)} %</div>}<div className="form-grid"><label>{c.loss}<input type="number" placeholder="0" value={rejected} onChange={e=>setRejected(e.target.value)}/></label><label>Remarque<textarea value={note} onChange={e=>setNote(e.target.value)} placeholder="Observation facultative…"/></label></div><button className="primary giant" disabled={!number} onClick={save}>Valider les quantités réelles</button></div><div className="card table-card"><div className="list-toolbar"><div><h2>Rapport du jour · {workshop}</h2><p>{records.length} enregistrement(s)</p></div><div className="search"><Search/><input value={search} onChange={e=>setSearch(e.target.value)} placeholder={c.search}/></div></div><div className="workshop-report"><div className="workshop-report-row head"><span>N°</span><span>Recette / format</span><span>Responsable</span><span>Attendu</span><span>Obtenu</span><span>Non conforme</span><span>Rendement</span></div>{records.filter(r=>`${r.id} ${r.product} ${r.createdBy}`.toLowerCase().includes(search.toLowerCase())).map(r=><div className="workshop-report-row" key={r.id}><span><b>{r.id}</b></span><span>{r.product}</span><span>{r.createdBy}</span><span>{r.expected} {c.unit}</span><span>{r.dough} {c.unit}</span><span>{r.failed||0}</span><span className={(r.good||0)/r.expected>=.95?'rate good':(r.good||0)/r.expected>=.85?'rate medium':'rate bad'}>{(((r.good||0)/r.expected)*100).toFixed(1)} %</span></div>)}</div></div></div>
}
function Quality({site,toast}:{site:Site;toast:(s:string)=>void}) { const [removed,setRemoved]=useState<string[]>([]);const rows=[['Yaourt nature','Aujourd’hui','12'],['Tartelette','Demain','8'],['Pain de mie','Dans 3 jours','16']];return <div className="card table-card"><CardTitle title={`Péremptions · ${site}`} subtitle="Produits à surveiller"/>{rows.map((r,i)=><div className="quality-row" key={r[0]}><span className={`expiry e${i}`}>{i===0?'J-0':i===1?'J-1':'J-3'}</span><div><b>{r[0]}</b><p>{r[2]} unités · Expire {r[1].toLowerCase()}</p></div>{removed.includes(r[0])?<em className="badge neutral">Isolé</em>:<button className="outline danger" onClick={()=>{setRemoved([...removed,r[0]]);toast(`${r[0]} retiré du stock vendable`)}}>Retirer du comptoir</button>}</div>)}</div> }
function Inventory({data,setData,profile,toast}:{data:DemoData;setData:React.Dispatch<React.SetStateAction<DemoData>>;profile:Profile;toast:(s:string)=>void}) {
  const canCreate=profile.role==='manager'||profile.role==='inventaire',canValidate=profile.role==='manager'||profile.role==='gerant'
  const [selectedId,setSelectedId]=useState<string|null>(null),[open,setOpen]=useState(false),[search,setSearch]=useState('')
  const [site,setSite]=useState<Site>('Les Palmiers'),[planned,setPlanned]=useState(new Date(Date.now()+86400000).toISOString().slice(0,10)),[type,setType]=useState('Complet'),[comment,setComment]=useState(''),[surprise,setSurprise]=useState(true)
  const [filterSite,setFilterSite]=useState('Tous'),[filterStatus,setFilterStatus]=useState('Tous'),[filterCreator,setFilterCreator]=useState('Tous'),[period,setPeriod]=useState('Toutes')
  const visible=data.inventories.filter(i=>(profile.role==='inventaire'||profile.role==='manager'||i.site===profile.site)&&(filterSite==='Tous'||i.site===filterSite)&&(filterStatus==='Tous'||i.status===filterStatus)&&(filterCreator==='Tous'||i.createdBy===filterCreator)&&(period==='Toutes'||(period==='À venir'?i.plannedDate>=new Date().toISOString().slice(0,10):i.plannedDate<new Date().toISOString().slice(0,10))))
  const selected=data.inventories.find(i=>i.id===selectedId)
  const scopedProducts=(inv:InventoryRecord)=>products.filter(p=>inv.type==='Complet'||(inv.type==='Matières premières'&&p.category==='Matières premières')||(inv.type==='Produits finis'&&p.category!=='Matières premières')||(inv.type==='Emballages'&&p.category==='Emballages'))
  function create(){const now=new Date().toLocaleString('fr-FR'),inv:InventoryRecord={id:`INV-2026-${String(data.inventories.length+22).padStart(3,'0')}`,site,plannedDate:planned,type,assigned:['Roméo Gbaguidi'],comment,surprise,status:'Planifié',snapshot:{},counts:{},remarks:{},createdBy:profile.name,createdByRole:profile.title,history:[{label:'Créé',user:profile.name,role:profile.title,at:now}]};setData(d=>({...d,inventories:[inv,...d.inventories],activities:[{id:`a-${Date.now()}`,text:`Inventaire ${inv.id} planifié${surprise?' en mode surprise':' · équipe locale prévenue'}`,site,user:profile.name,time:'À l’instant',kind:'Inventaire'},...d.activities]}));setOpen(false);setSelectedId(inv.id);toast(surprise?'Inventaire surprise planifié discrètement':'Inventaire planifié · équipe locale prévenue')}
  function start(inv:InventoryRecord){const list=scopedProducts(inv),snapshot=Object.fromEntries(list.map(p=>[p.id,data.stocks[inv.site][p.id]||0])),event={label:'Comptage commencé',user:profile.name,role:profile.title,at:new Date().toLocaleString('fr-FR')};setData(d=>({...d,inventories:d.inventories.map(i=>i.id===inv.id?{...i,status:'En cours',snapshot,countedBy:profile.name,history:[...(i.history||[]),event]}:i),activities:[{id:`a-${Date.now()}`,text:`Comptage ${inv.id} démarré · Gérant et Magasinier prévenus`,site:inv.site,user:profile.name,time:'À l’instant',kind:'Inventaire'},...d.activities]}));toast('Stock théorique figé · équipe locale prévenue')}
  function count(inv:InventoryRecord,id:string,value:number){setData(d=>({...d,inventories:d.inventories.map(i=>i.id===inv.id?{...i,counts:{...i.counts,[id]:Math.max(0,value)}}:i)}))}
  function remark(inv:InventoryRecord,id:string,value:string){setData(d=>({...d,inventories:d.inventories.map(i=>i.id===inv.id?{...i,remarks:{...i.remarks,[id]:value}}:i)}))}
  function submit(inv:InventoryRecord){const event={label:'Comptage terminé et soumis',user:profile.name,role:profile.title,at:new Date().toLocaleString('fr-FR')};setData(d=>({...d,inventories:d.inventories.map(i=>i.id===inv.id?{...i,status:'À valider',submittedBy:profile.name,history:[...(i.history||[]),event]}:i),activities:[{id:`a-${Date.now()}`,text:`Inventaire ${inv.id} soumis pour validation`,site:inv.site,user:profile.name,time:'À l’instant',kind:'Inventaire'},...d.activities]}));toast('Inventaire soumis au Gérant et à la Direction')}
  function validate(inv:InventoryRecord){const diffs=Object.keys(inv.snapshot).filter(id=>inv.counts[id]!==undefined&&inv.counts[id]!==inv.snapshot[id]);const adjusted={...data.stocks[inv.site]};diffs.forEach(id=>adjusted[id]=inv.counts[id]);const net=diffs.reduce((s,id)=>s+(inv.counts[id]-inv.snapshot[id])*(products.find(p=>p.id===id)?.price||0),0),at=new Date().toLocaleString('fr-FR');setData(d=>({...d,stocks:{...d.stocks,[inv.site]:adjusted},inventories:d.inventories.map(i=>i.id===inv.id?{...i,status:'Validé',validatedBy:profile.name,validatedAt:at,history:[...(i.history||[]),{label:'Validé',user:profile.name,role:profile.title,at},{label:'Stock ajusté',user:'Système',role:'Application',at}]}:i),activities:[{id:`a-${Date.now()}`,text:`Inventaire ${inv.id} validé · ${diffs.length} ajustement(s) · ${money(net)}`,site:inv.site,user:profile.name,time:'À l’instant',kind:'Inventaire'},{id:`n-${Date.now()}`,text:`Notification Gérant et Magasinier : stock ajusté après ${inv.id}`,site:inv.site,user:profile.name,time:'À l’instant',kind:'Notification'},...d.activities]}));toast('Inventaire validé · stock ajusté et équipes notifiées')}
  function recount(inv:InventoryRecord){const reason=prompt('Motif du renvoi pour recomptage (obligatoire)');if(!reason)return;const event={label:'Renvoyé pour recomptage',user:profile.name,role:profile.title,at:new Date().toLocaleString('fr-FR'),note:reason};setData(d=>({...d,inventories:d.inventories.map(i=>i.id===inv.id?{...i,status:'En cours',history:[...(i.history||[]),event]}:i),activities:[{id:`a-${Date.now()}`,text:`Inventaire ${inv.id} renvoyé : ${reason}`,site:inv.site,user:profile.name,time:'À l’instant',kind:'Inventaire'},...d.activities]}));toast('Inventaire renvoyé pour recomptage')}
  if(selected){const list=scopedProducts(selected).filter(p=>p.name.toLowerCase().includes(search.toLowerCase())),done=Object.keys(selected.counts).length,total=scopedProducts(selected).length;const reconciliation=['À valider','Validé'].includes(selected.status);const diffs=list.map(p=>({p,theory:selected.snapshot[p.id]||0,counted:selected.counts[p.id]??0,diff:(selected.counts[p.id]??0)-(selected.snapshot[p.id]||0)}));const missing=diffs.filter(d=>d.diff<0).reduce((s,d)=>s+d.diff*d.p.price,0),excess=diffs.filter(d=>d.diff>0).reduce((s,d)=>s+d.diff*d.p.price,0),withDiff=diffs.filter(d=>d.diff!==0).length,reliability=total?Math.max(0,(1-withDiff/total)*100):100;return <div className="stack"><button className="back-button" onClick={()=>setSelectedId(null)}>← Retour aux inventaires</button><div className="inventory-head card"><div><p className="eyebrow">{selected.status}</p><h2>{selected.id} · {selected.site}</h2><p>{selected.type} · prévu le {new Date(selected.plannedDate+'T12:00').toLocaleDateString('fr-FR')} · {selected.assigned.join(', ')}</p></div><div className="inventory-actions">{selected.status==='Planifié'&&profile.role==='inventaire'&&<button className="primary" onClick={()=>start(selected)}>Commencer le comptage</button>}{selected.status==='En cours'&&profile.role==='inventaire'&&<button className="primary" disabled={done===0} onClick={()=>submit(selected)}>Terminer et soumettre</button>}{selected.status==='À valider'&&canValidate&&<><button className="outline danger" onClick={()=>recount(selected)}>Renvoyer pour recomptage</button><button className="primary" onClick={()=>validate(selected)}>Valider et ajuster le stock</button></>}<button className="outline" onClick={()=>window.print()}>Imprimer / PDF</button><button className="outline" onClick={()=>toast('Export Excel généré (simulation)')}>Excel</button></div></div><div className="inventory-timeline card"><h3>Chronologie complète</h3>{(selected.history||[{label:'Créé',user:selected.createdBy,role:selected.createdByRole||'Utilisateur',at:'Date non disponible'}]).map((e,i)=><div className="timeline-event" key={`${e.label}-${i}`}><span>{i+1}</span><div><b>{e.label}</b><p>{e.user} · {e.role}</p>{e.note&&<em>{e.note}</em>}</div><time>{e.at}</time></div>)}</div>{selected.status==='En cours'&&<><div className="progress-card card"><div><b>{done} / {total} produits comptés</b><span>{Math.round(done/Math.max(total,1)*100)} %</span></div><i><span style={{width:`${done/Math.max(total,1)*100}%`}}/></i><p><ShieldCheck/> Comptage à l’aveugle : le stock théorique est masqué.</p></div><div className="search"><Search/><input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Rechercher un produit…"/></div><div className="inventory-groups">{[...new Set(list.map(p=>p.category))].map(cat=><section key={cat}><h3>{cat}</h3>{list.filter(p=>p.category===cat).map(p=>{const value=selected.counts[p.id];return <div className="count-row" key={p.id}><span>{p.emoji}</span><div><b>{p.name}</b><small>{p.category==='Matières premières'?'kg':'unité'}</small></div><div className="count-controls"><input type="number" placeholder="Quantité" value={value??''} onChange={e=>count(selected,p.id,Number(e.target.value))}/><button onClick={()=>count(selected,p.id,(value||0)+1)}>+1</button><button onClick={()=>count(selected,p.id,(value||0)+10)}>+10</button></div><input className="count-note" placeholder="Remarque facultative…" value={selected.remarks[p.id]||''} onChange={e=>remark(selected,p.id,e.target.value)}/></div>})}</section>)}</div></>}{reconciliation&&<><div className="inventory-summary"><Kpi icon={AlertTriangle} label="Produits avec écart" value={`${withDiff}`} note={`${total} contrôlés`}/><Kpi icon={TrendingUp} label="Manquants" value={money(missing)} note="Valeur négative"/><Kpi icon={Plus} label="Excédents" value={money(excess)} note="Valeur positive"/><Kpi icon={BarChart3} label="Écart net" value={money(missing+excess)} note={`${reliability.toFixed(1)} % de fiabilité`}/></div><div className="card table-card"><div className="reconcile-tr head"><span>Produit</span><span>Théorique</span><span>Compté</span><span>Écart</span><span>Valeur</span><span>Remarque</span></div>{diffs.map(({p,theory,counted,diff})=><div className={`reconcile-tr ${Math.abs(diff)>1?'major':diff?'minor':'exact'}`} key={p.id}><span><b>{p.emoji} {p.name}</b></span><span>{theory}</span><span>{counted}</span><span><b>{diff>0?'+':''}{diff}</b></span><span>{money(diff*p.price)}</span><span>{selected.remarks[p.id]||'—'}</span></div>)}</div></>}</div>}
  return <div className="stack"><div className="list-toolbar"><div><h2>Inventaires</h2><p>Contrôle transversal et indépendant des stocks</p></div>{canCreate&&<button className="primary" onClick={()=>setOpen(true)}><Plus/> Créer un inventaire</button>}</div><div className="inventory-filters"><select value={filterSite} onChange={e=>setFilterSite(e.target.value)}><option>Tous</option>{sites.map(s=><option key={s}>{s}</option>)}</select><select value={period} onChange={e=>setPeriod(e.target.value)}><option>Toutes</option><option>À venir</option><option>Passées</option></select><select value={filterStatus} onChange={e=>setFilterStatus(e.target.value)}><option>Tous</option>{['Planifié','En cours','À valider','Validé'].map(s=><option key={s}>{s}</option>)}</select><select value={filterCreator} onChange={e=>setFilterCreator(e.target.value)}><option>Tous</option>{[...new Set(data.inventories.map(i=>i.createdBy))].map(n=><option key={n}>{n}</option>)}</select></div><div className="inventory-board">{['Planifié','En cours','À valider','Validé'].map(status=><section className="card" key={status}><h3>{status}</h3>{visible.filter(i=>i.status===status).map(i=>{const total=Object.keys(i.snapshot).length||scopedProducts(i).length,done=Object.keys(i.counts).length,net=Object.keys(i.counts).reduce((s,id)=>s+(i.counts[id]-(i.snapshot[id]||0))*(products.find(p=>p.id===id)?.price||0),0);return <button className="inventory-card detailed" key={i.id} onClick={()=>setSelectedId(i.id)}><div className="inventory-card-top"><span className="site-icon"><ClipboardCheck/></span><span><b>{i.id}</b><small>{i.site} · {new Date(i.plannedDate+'T12:00').toLocaleDateString('fr-FR')}</small></span>{i.surprise&&<em className="badge warn">Surprise</em>}</div><dl><div><dt>Type</dt><dd>{i.type==='Complet'?'Complet':`Partiel · ${i.type}`}</dd></div><div><dt>Créé par</dt><dd>{i.createdBy}<small>{i.createdByRole}</small></dd></div><div><dt>Assigné à</dt><dd>{i.assigned.join(', ')}</dd></div><div><dt>Progression</dt><dd>{done} / {total}</dd></div>{['À valider','Validé'].includes(i.status)&&<div><dt>Écart net</dt><dd className={net===0?'rate good':'rate bad'}>{money(net)}</dd></div>}</dl><div className="card-progress"><i style={{width:`${done/Math.max(total,1)*100}%`}}/></div></button>})}{!visible.some(i=>i.status===status)&&<p className="empty-column">Aucun inventaire</p>}</section>)}</div>{open&&<div className="modal-backdrop"><div className="form-modal"><div className="modal-heading"><h2>Créer un inventaire</h2><button onClick={()=>setOpen(false)}><X/></button></div><div className="form-grid"><label>Site<select value={site} onChange={e=>setSite(e.target.value as Site)}>{sites.map(s=><option key={s}>{s}</option>)}</select></label><label>Date prévue<input type="date" value={planned} onChange={e=>setPlanned(e.target.value)}/></label><label>Type<select value={type} onChange={e=>setType(e.target.value)}><option>Complet</option><option>Matières premières</option><option>Produits finis</option><option>Emballages</option></select></label><label>Membre assigné<input value="Roméo Gbaguidi" disabled/></label></div><label className="surprise-option"><input type="checkbox" checked={surprise} onChange={e=>setSurprise(e.target.checked)}/><span><b>Inventaire surprise</b><small>Le Gérant et le Magasinier seront prévenus au démarrage du comptage.</small></span></label><label className="block-label">Commentaire<textarea className="production-note" value={comment} onChange={e=>setComment(e.target.value)}/></label><div className="modal-actions"><button className="outline" onClick={()=>setOpen(false)}>Annuler</button><button className="primary" onClick={create}>Planifier</button></div></div></div>}</div>
}
function UsersView({data,setData,toast}:{data:DemoData;setData:React.Dispatch<React.SetStateAction<DemoData>>;toast:(s:string)=>void}){
  const [open,setOpen]=useState(false);const [editing,setEditing]=useState<Profile|null>(null)
  const blank={name:'',username:'',password:'',phone:'',role:'caissier' as Role,site:'Les Palmiers' as Site}
  const [form,setForm]=useState(blank);const [error,setError]=useState('')
  function begin(u?:Profile){setEditing(u||null);setForm(u?{name:u.name,username:u.username,password:u.password,phone:u.phone||'',role:u.role,site:u.site||'Les Palmiers'}:blank);setError('');setOpen(true)}
  function save(){if(!form.name.trim()||!form.username.trim()||!form.password.trim()){setError('Nom, identifiant et mot de passe sont obligatoires.');return}if(data.users.some(u=>u.username===form.username&&u.id!==editing?.id)){setError('Cet identifiant est déjà utilisé.');return}const names=form.name.trim().split(' ');const user:Profile={id:editing?.id||`u-${Date.now()}`,name:form.name.trim(),username:form.username.trim(),password:form.password,phone:form.phone,role:form.role,site:['manager','qualite','inventaire'].includes(form.role)?undefined:form.site,title:roleTitle(form.role),initials:names.map(n=>n[0]).join('').slice(0,2).toUpperCase(),active:editing?.active??true};setData(d=>({...d,users:editing?d.users.map(u=>u.id===editing.id?user:u):[...d.users,user],activities:[{id:`a-${Date.now()}`,text:`Compte ${editing?'modifié':'créé'} : ${user.name}`,site:'Magasin central',user:'Direction',time:'À l’instant',kind:'Accès'},...d.activities]}));setOpen(false);toast(editing?'Utilisateur modifié':'Utilisateur créé · connexion disponible immédiatement')}
  function toggle(u:Profile){setData(d=>({...d,users:d.users.map(x=>x.id===u.id?{...x,active:!x.active}:x)}));toast(u.active?'Compte désactivé':'Compte réactivé')}
  function resetPassword(u:Profile){const pwd=`demo${Math.floor(1000+Math.random()*9000)}`;setData(d=>({...d,users:d.users.map(x=>x.id===u.id?{...x,password:pwd}:x)}));toast(`Nouveau mot de passe : ${pwd}`)}
  return <div className="card table-card"><div className="list-toolbar"><div><h2>Utilisateurs & accès</h2><p>{data.users.length} comptes · changements immédiats</p></div><button className="primary" onClick={()=>begin()}><Plus size={16}/> Nouvel utilisateur</button></div>{[undefined,...sites].map(group=><section className="team-group" key={group||'global'}><h3>{group||'Direction & transversal'} <span>{data.users.filter(u=>u.site===group).length} membres</span></h3>{data.users.filter(u=>u.site===group).map(p=><div className={`user-row ${!p.active?'disabled':''}`} key={p.id}><span className="avatar">{p.initials}</span><div><b>{p.name}</b><p>@{p.username} · {p.title}</p></div><em className={p.active?'badge ok':'badge neutral'}>{p.active?'Actif':'Désactivé'}</em><div className="row-actions"><button onClick={()=>begin(p)}>Modifier</button><button onClick={()=>resetPassword(p)}>Réinitialiser MDP</button><button className="danger-text" onClick={()=>toggle(p)}>{p.active?'Désactiver':'Réactiver'}</button></div></div>)}</section>)}{open&&<div className="modal-backdrop"><div className="form-modal"><div className="modal-heading"><div><p className="eyebrow">Gestion des accès</p><h2>{editing?'Modifier le compte':'Nouvel utilisateur'}</h2></div><button onClick={()=>setOpen(false)}><X/></button></div><div className="form-grid"><label>Nom complet *<input value={form.name} onChange={e=>setForm({...form,name:e.target.value})}/></label><label>Téléphone<input value={form.phone} onChange={e=>setForm({...form,phone:e.target.value})}/></label><label>Identifiant *<input value={form.username} onChange={e=>setForm({...form,username:e.target.value})}/></label><label>Mot de passe *<input value={form.password} onChange={e=>setForm({...form,password:e.target.value})}/></label><label>Rôle<select value={form.role} onChange={e=>setForm({...form,role:e.target.value as Role})}>{Object.keys(navByRole).map(r=><option value={r} key={r}>{roleTitle(r as Role)}</option>)}</select></label>{!['manager','qualite','inventaire'].includes(form.role)&&<label>Site<select value={form.site} onChange={e=>setForm({...form,site:e.target.value as Site})}>{sites.map(s=><option key={s}>{s}</option>)}</select></label>}</div>{error&&<div className="form-error"><AlertTriangle size={16}/>{error}</div>}<div className="modal-actions"><button className="outline" onClick={()=>setOpen(false)}>Annuler</button><button className="primary" onClick={save}>Enregistrer</button></div></div></div>}</div>
}
const roleGuides:Record<Role,{role:string;actions:string[];steps:string[];works:string;try:string}>={
  manager:{role:'Vous pilotez toute l’entreprise et arbitrez les décisions.',actions:['Comparer les sites','Valider les inventaires','Créer des utilisateurs'],steps:['Choisissez Tous les sites','Ouvrez une carte site','Traitez les alertes'],works:'Vous recevez les informations de toutes les équipes.',try:'Créez un utilisateur, puis connectez-vous avec ce nouveau compte.'},
  gerant:{role:'Vous supervisez toutes les opérations de votre site.',actions:['Suivre ventes et stock','Voir les fournées','Valider un inventaire'],steps:['Consultez Mon site','Ouvrez Production','Traitez les demandes'],works:'Vous coordonnez Magasinier, ateliers et Caisse.',try:'Ouvrez une fournée puis vérifiez son rendement.'},
  caissier:{role:'Vous encaissez les ventes et clôturez votre caisse.',actions:['Faire une vente','Consulter les tickets','Clôturer la caisse'],steps:['Touchez un produit','Choisissez le paiement','Imprimez le ticket'],works:'Vous recevez le stock distribué par l’Enfourneur.',try:'Vendez une baguette puis ouvrez le compte gerant du même site.'},
  magasinier:{role:'Vous gérez le stock et approvisionnez les ateliers.',actions:['Enregistrer une entrée','Traiter une demande','Suivre la production'],steps:['Ouvrez Stock','Cliquez Nouvelle entrée','Vérifiez le nouveau solde'],works:'Vous alimentez les ateliers et recevez leurs alertes.',try:'Ajoutez 100 kg de farine puis connectez-vous avec boulanger du même site.'},
  production:{role:'Vous réalisez les productions de votre atelier uniquement.',actions:['Créer ou traiter un lot','Déclarer le résultat réel','Suivre le rendement'],steps:['Ouvrez Production','Saisissez les quantités réelles','Validez la déclaration'],works:'Boulanger → Enfourneur → Boutique, avec suivi du Gérant.',try:'Déclarez vos pâtons puis utilisez enfourneur du même site.'},
  qualite:{role:'Vous contrôlez la qualité et les péremptions sur tous les sites.',actions:['Identifier les produits à risque','Retirer du comptoir','Tracer un constat'],steps:['Choisissez un site','Ouvrez un produit','Enregistrez la décision'],works:'Vous informez le Gérant et la Direction.',try:'Retirez un produit puis vérifiez son statut isolé.'},
  inventaire:{role:'Vous contrôlez indépendamment les stocks physiques.',actions:['Planifier un inventaire','Compter à l’aveugle','Soumettre les écarts'],steps:['Créez un inventaire','Commencez le comptage','Soumettez au Manager'],works:'Le Manager ou le Gérant valide vos rapprochements.',try:'Comptez la farine avec un écart puis connectez-vous avec manager.'},
}
function HelpPage({profile}:{profile:Profile}){const g=roleGuides[profile.role];return <div className="help-page"><div className="help-hero"><CircleHelp/><div><p className="eyebrow">Centre d’aide</p><h2>{profile.title} · {profile.site||'Tous les sites'}</h2><p>{g.role}</p></div></div><div className="help-grid"><section className="card"><h3>Ce que vous pouvez faire</h3>{g.actions.map(x=><p key={x}><span>✓</span>{x}</p>)}</section><section className="card"><h3>Pas à pas</h3>{g.steps.map((x,i)=><p key={x}><b>{i+1}</b>{x}</p>)}</section><section className="card"><h3>Avec qui vous travaillez</h3><p>{g.works}</p></section><section className="card try-card"><h3>Essayez maintenant</h3><p>{g.try}</p></section></div></div>}
function specificGuide(profile:Profile){const base=roleGuides[profile.role];if(profile.username.startsWith('patissier.'))return{...base,role:'Vous préparez, cuisez et décorez les produits de pâtisserie.',actions:['Créer une préparation','Saisir les pièces obtenues','Déclarer les pièces non conformes','Consulter le rapport pâtisserie'],steps:['Choisissez une recette et un format','Indiquez la quantité attendue','Saisissez uniquement le résultat réel','Validez puis consultez le rendement'],works:'Vous recevez les matières du Magasinier et transmettez les produits finis à la boutique.',try:'Créez une préparation de tartelettes puis ouvrez le compte gerant du même site.'};if(profile.username.startsWith('yaourt.'))return{...base,role:'Vous pilotez la préparation, la fermentation et le conditionnement des yaourts.',actions:['Créer un lot','Suivre la fermentation','Déclarer les pots conditionnés','Signaler les pots non conformes'],steps:['Choisissez la recette et le format','Contrôlez la durée et la température','Saisissez les pots réellement obtenus','Validez le lot'],works:'Le Magasinier fournit lait et ferments ; la boutique reçoit les pots distribués.',try:'Créez un lot nature puis consultez-le avec gerant du même site.'};if(profile.username.startsWith('glace.'))return{...base,role:'Vous gérez le mix, la maturation, le turbinage et le conditionnement des glaces.',actions:['Créer un lot','Suivre maturation et turbinage','Déclarer pots et bacs','Tracer les pertes'],steps:['Choisissez parfum et format','Préparez le mix','Saisissez les contenants réellement obtenus','Validez le lot'],works:'Le Magasinier fournit les ingrédients ; la boutique reçoit les contenants distribués.',try:'Créez un lot coco en bacs puis consultez-le avec gerant du même site.'};if(profile.username.startsWith('enfourneur.'))return{...base,role:'Vous prenez en charge les productions prêtes à cuire et distribuez le résultat.',actions:['Démarrer la cuisson','Déclarer bons et ratés','Distribuer vers la boutique'],steps:['Choisissez une fiche en attente','Démarrez la cuisson','Saisissez la sortie réelle','Répartissez la production'],works:'Vous recevez du Boulanger et transmettez à la boutique.',try:'Traitez la fiche reçue puis connectez-vous avec caisse du même site.'};return base}
function tourContent(profile:Profile){const g=specificGuide(profile);return[{title:`Bienvenue ${profile.name.split(' ')[0]}`,text:`Découvrez les fonctions autorisées pour votre poste de ${profile.title}.`,target:'header'},{title:'Navigation',text:'Le menu réunit uniquement les modules accessibles à votre rôle.',target:'nav'},{title:g.actions[0],text:`Utilisez cet espace pour ${g.actions[0].toLowerCase()} avec une traçabilité complète.`,target:'.page'},{title:g.actions[1],text:`Les résultats de l’action « ${g.actions[1]} » sont immédiatement partagés avec les postes concernés.`,target:'.card'},{title:'Alertes et aide',text:'La cloche affiche vos alertes et le bouton d’aide permet de revoir ce tutoriel.',target:'.header-actions'},{title:'Vous êtes prêt !',text:g.try,target:'.page'}]}
function Tour({profile,step,setStep,close,openHelp:_openHelp}:{profile:Profile;step:number;setStep:(n:number)=>void;close:()=>void;openHelp:()=>void}){const steps=tourContent(profile),current=steps[step];const [rect,setRect]=useState<DOMRect|null>(null);useEffect(()=>{const el=document.querySelector(current.target);el?.scrollIntoView({behavior:'smooth',block:'center'});const timer=setTimeout(()=>setRect(el?.getBoundingClientRect()||null),250);return()=>clearTimeout(timer)},[step,current.target]);function finish(){localStorage.setItem(`tour-${profile.username}`,'vu');close()}return <div className="tour-overlay"><div className="tour-spot" style={rect?{left:Math.max(8,rect.left-8),top:Math.max(8,rect.top-8),width:Math.min(window.innerWidth-16,rect.width+16),height:rect.height+16}:undefined}/><div className="tour-popover"><button className="skip-tour" onClick={finish}>Passer le tutoriel</button><span>{step+1}/{steps.length}</span><h3>{current.title}</h3><p>{current.text}</p><div className="tour-points">{steps.map((_,i)=><button aria-label={`Étape ${i+1}`} className={i===step?'active':''} onClick={()=>setStep(i)} key={i}/>)}</div><div className="tour-actions"><button disabled={step===0} onClick={()=>setStep(step-1)}>Précédent</button>{step<steps.length-1?<button className="primary" onClick={()=>setStep(step+1)}>Suivant</button>:<button className="primary" onClick={finish}>Terminer · Accéder à mon espace</button>}</div></div></div>}
function HelpDrawer({profile,close,restart}:{profile:Profile;close:()=>void;restart:()=>void}){const g=specificGuide(profile);return <div className="help-backdrop" onClick={close}><aside className="help-drawer" onClick={e=>e.stopPropagation()}><div className="help-drawer-head"><div><p className="eyebrow">Aide et paramètres</p><h2>{profile.title}</h2></div><button onClick={close}><X/></button></div><section><h3>Votre rôle</h3><p>{g.role}</p></section><section><h3>Ce que vous pouvez faire</h3><ul>{g.actions.map(a=><li key={a}>{a}</li>)}</ul></section><section><h3>Guides pas à pas</h3>{g.steps.map((s,i)=><details key={s}><summary><b>{i+1}</b>{s}</summary><p>Suivez les champs dans l’ordre, saisissez les valeurs réelles puis confirmez. Une notification est envoyée au poste suivant.</p></details>)}</section><section><h3>Avec qui vous travaillez</h3><div className="work-flow"><span>Entrées reçues</span><b>→</b><strong>{profile.title}</strong><b>→</b><span>Poste suivant</span></div><p>{g.works}</p></section><section className="try-help"><h3>Essayez maintenant</h3><p>{g.try}</p></section><button className="primary restart-tour" onClick={restart}>Revoir le tutoriel</button></aside></div>}
function roleTitle(role:Role){return ({manager:'Manager général',gerant:'Gérant de site',caissier:'Caissier',magasinier:'Magasinier',production:'Responsable production',qualite:'Contrôleur qualité',inventaire:'Équipe inventaire'})[role]}
function Purchases({toast}:{toast:(s:string)=>void}){return <div className="card table-card"><CardTitle title="Commandes fournisseurs" subtitle="2 commandes en cours"/>{[['CMD-042','Moulins du Bénin','1 250 000','Commandée'],['CMD-043','Laiterie de Cotonou','486 000','Réception partielle']].map(r=><div className="request-row" key={r[0]}><span className="site-icon"><PackageCheck/></span><div><b>{r[1]}</b><p>{r[0]} · {money(Number(r[2].replaceAll(' ','')))}</p></div><em className="badge warn">{r[3]}</em><button className="primary small" onClick={()=>toast('Réception ouverte pour contrôle')}>Réceptionner</button></div>)}</div>}
function CloseCash({total,toast}:{total:number;toast:(s:string)=>void}){const [actual,setActual]=useState('');const diff=Number(actual)-total;return <div className="close-panel card"><ClipboardCheck/><h2>Clôture de caisse</h2><p>Montant théorique calculé à partir des ventes du jour.</p><div className="close-value"><span>Théorique</span><b>{money(total)}</b></div><label>Montant réellement compté<input type="number" value={actual} onChange={e=>setActual(e.target.value)} placeholder="0 FCFA"/></label>{actual&&<div className={diff===0?'difference ok':'difference bad'}>Écart : {money(diff)}</div>}<button className="primary giant" onClick={()=>toast('Clôture validée · rapport transmis au gérant')}>Valider la clôture</button></div>}
