function demoInventories():InventoryRecord[]{
  const iso=(days:number)=>{const d=new Date();d.setDate(d.getDate()+days);return d.toISOString().slice(0,10)}, at=(days:number,time:string)=>`${new Date(Date.now()+days*86400000).toLocaleDateString('fr-FR')} ${time}`
  return [
    {id:'INV-2026-021',site:'Les Palmiers',plannedDate:iso(1),type:'Complet',assigned:['Roméo Gbaguidi','Flore Gandonou'],comment:'Contrôle trimestriel',surprise:true,status:'Planifié',snapshot:{},counts:{},remarks:{},createdBy:'Aïcha Hounkpatin',createdByRole:'Manager général',history:[{label:'Créé',user:'Aïcha Hounkpatin',role:'Manager général',at:at(0,'09:10')}]},
    {id:'INV-2026-020',site:'Marché',plannedDate:iso(0),type:'Matières premières',assigned:['Roméo Gbaguidi'],comment:'Contrôle ciblé',surprise:true,status:'En cours',snapshot:{farine:165,levure:9,sel:22,'sucre-mp':116,beurre:31,lait:72,oeufs:240},counts:{farine:164,levure:9,sel:22},remarks:{farine:'Sac endommagé'},createdBy:'Roméo Gbaguidi',createdByRole:'Équipe inventaire',countedBy:'Roméo Gbaguidi',history:[{label:'Créé',user:'Roméo Gbaguidi',role:'Équipe inventaire',at:at(-1,'16:30')},{label:'Comptage commencé',user:'Roméo Gbaguidi',role:'Équipe inventaire',at:at(0,'08:05')}]},
    {id:'INV-2026-019',site:'Centre-Ville',plannedDate:iso(-1),type:'Complet',assigned:['Roméo Gbaguidi','Grâce Tchibozo'],comment:'Clôture mensuelle',surprise:false,status:'À valider',snapshot:{farine:240,levure:12,sel:28,bag:58,mie:42,croissant:46},counts:{farine:238,levure:12,sel:27,bag:56,mie:42,croissant:45},remarks:{farine:'Deux sacs manquants'},createdBy:'Aïcha Hounkpatin',createdByRole:'Manager général',countedBy:'Roméo Gbaguidi',submittedBy:'Roméo Gbaguidi',history:[{label:'Créé',user:'Aïcha Hounkpatin',role:'Manager général',at:at(-3,'10:15')},{label:'Comptage commencé',user:'Roméo Gbaguidi',role:'Équipe inventaire',at:at(-1,'07:45')},{label:'Comptage terminé et soumis',user:'Roméo Gbaguidi',role:'Équipe inventaire',at:at(-1,'11:20')}]},
    {id:'INV-2026-018',site:'Magasin central',plannedDate:iso(-5),type:'Complet',assigned:['Roméo Gbaguidi'],comment:'Contrôle mensuel',surprise:false,status:'Validé',snapshot:{farine:382,levure:19,sel:45,bag:40},counts:{farine:380,levure:19,sel:44,bag:42},remarks:{farine:'Un sac entamé'},createdBy:'Aïcha Hounkpatin',createdByRole:'Manager général',countedBy:'Roméo Gbaguidi',submittedBy:'Roméo Gbaguidi',validatedBy:'Aïcha Hounkpatin',validatedAt:at(-5,'15:10'),history:[{label:'Créé',user:'Aïcha Hounkpatin',role:'Manager général',at:at(-7,'09:00')},{label:'Comptage commencé',user:'Roméo Gbaguidi',role:'Équipe inventaire',at:at(-5,'08:10')},{label:'Comptage terminé et soumis',user:'Roméo Gbaguidi',role:'Équipe inventaire',at:at(-5,'12:40')},{label:'Validé',user:'Aïcha Hounkpatin',role:'Manager général',at:at(-5,'15:10')},{label:'Stock ajusté',user:'Système',role:'Application',at:at(-5,'15:10')}]},
    {id:'INV-2026-017',site:'Les Palmiers',plannedDate:iso(-12),type:'Produits finis',assigned:['Roméo Gbaguidi'],comment:'Contrôle surprise',surprise:true,status:'Validé',snapshot:{bag:62,mie:49,croissant:51},counts:{bag:60,mie:49,croissant:50},remarks:{bag:'Deux unités abîmées'},createdBy:'Roméo Gbaguidi',createdByRole:'Équipe inventaire',countedBy:'Roméo Gbaguidi',submittedBy:'Roméo Gbaguidi',validatedBy:'Nadine Ahouansou',validatedAt:at(-12,'14:25'),history:[{label:'Créé',user:'Roméo Gbaguidi',role:'Équipe inventaire',at:at(-12,'07:30')},{label:'Comptage commencé',user:'Roméo Gbaguidi',role:'Équipe inventaire',at:at(-12,'08:00')},{label:'Comptage terminé et soumis',user:'Roméo Gbaguidi',role:'Équipe inventaire',at:at(-12,'11:50')},{label:'Validé',user:'Nadine Ahouansou',role:'Gérante de site',at:at(-12,'14:25')},{label:'Stock ajusté',user:'Système',role:'Application',at:at(-12,'14:25')}]},
  ]
}
