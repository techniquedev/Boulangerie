import { useEffect, useMemo, useState } from 'react'
import {
  AlertTriangle, ArrowLeftRight, BarChart3, Bell, Boxes, ChevronRight,
  ClipboardCheck, Factory, LayoutDashboard, LogOut, Minus, PackageCheck,
  Plus, Receipt, RotateCcw, Search, ShieldCheck, ShoppingBasket, Store,
  Trash2, TrendingUp, Users, WalletCards, Wheat, X, CircleHelp, Sun, Moon, Monitor,
} from 'lucide-react'

type Site = 'Centre-Ville' | 'Les Palmiers' | 'Marché' | 'Magasin central'
type Role = 'manager' | 'gerant' | 'caissier' | 'magasinier' | 'production' | 'qualite' | 'inventaire'
type Profile = { id: string; name: string; title: string; role: Role; site?: Site; initials: string; username: string; password: string; phone?: string; active: boolean }
type Product = { id: string; name: string; category: string; price: number; emoji: string }
type Ticket = { id: string; site: Site; total: number; count: number; payment: string; date: string; cashier: string }
type Activity = { id: string; text: string; site: Site; user: string; time: string; kind: string }
type BatchStep = { label:string; user:string; at:string }
type Batch = { id:string; site:Site; workshop:string; product:string; flour:number; ingredients:Record<string,number>; expected:number; dough?:number; good?:number; failed?:number; note?:string; failureReason?:string; status:string; createdBy:string; ovenBy?:string; distributed?:number; destination?:string; createdDate?:string; steps:BatchStep[] }
type RequestLine = { productId:string; qty:number; delivered?:number }
type SupplyRequest = { id:string; site:Site; requester:string; date:string; type:string; urgency:string; comment:string; lines:RequestLine[]; status:string; refusal?:string }
type InventoryEvent = { label:string; user:string; role:string; at:string; note?:string }
type InventoryRecord = { id:string; site:Site; plannedDate:string; type:string; assigned:string[]; comment:string; surprise?:boolean; status:'Planifié'|'En cours'|'À valider'|'Validé'; snapshot:Record<string,number>; counts:Record<string,number>; remarks:Record<string,string>; createdBy:string; createdByRole?:string; countedBy?:string; submittedBy?:string; validatedBy?:string; validatedAt?:string; history?:InventoryEvent[] }
type DemoData = {
  stocks: Record<Site, Record<string, number>>
  tickets: Ticket[]
  activities: Activity[]
  expenses: { site: Site; label: string; amount: number; status: string }[]
  requests: SupplyRequest[]
  users: Profile[]
  batches: Batch[]
  inventories: InventoryRecord[]
}

