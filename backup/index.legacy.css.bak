@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap');
@import 'tailwindcss';

:root{--bg:#f7f2ea;--surface:#fffdf9;--border:#e6dccb;--primary:#6b4423;--dark:#3b2a1f;--accent:#b9804a;--success:#4e8a4b;--warning:#d08a1e;--danger:#b33a3a;--muted:#7c7066;--shadow:0 8px 30px rgba(68,45,25,.07);--radius:12px;--page-bg:#fff;--card-bg:#f5eee3;--field-bg:#fff;--sidebar-bg:#3b2a1f;--header-bg:#fff;--modal-bg:#fffdf9;--menu-bg:#fff;--secondary-bg:#f3eadf;--hover-bg:#f3e8da;--selected-bg:#eadcca;--text-main:#3b2a1f;--text-soft:#7c7066;--icon-color:#3b2a1f;--chevron-color:#6b4423;--action-bg:#6b4423;--action-text:#fff;--menu-hover:#f3e8da;--focus-ring:#b9804a}
*{box-sizing:border-box}body{margin:0;font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--dark)}button,input,select{font:inherit}button{cursor:pointer}h1,h2,h3,p{margin:0}.app-shell{min-height:100vh;display:grid;grid-template-columns:248px 1fr}aside{position:fixed;inset:0 auto 0 0;width:248px;background:var(--dark);color:#fff;padding:27px 18px;display:flex;flex-direction:column;z-index:20}.logo{display:flex;align-items:center;gap:11px;font-size:17px}.logo-mark{display:grid;place-items:center;width:39px;height:39px;background:var(--accent);border-radius:11px;color:#fff}.logo b,.logo small{display:block}.logo small{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#dcc8b4}.logo b{line-height:1.1}.logo b::after{content:' Boulangerie';font-weight:400}nav{display:flex;flex-direction:column;gap:5px;margin-top:50px}nav button,.aside-bottom button{border:0;background:none;color:#cdbeb2;display:flex;align-items:center;gap:13px;padding:12px 13px;border-radius:10px;text-align:left;font-size:14px;font-weight:600}nav button:hover,nav button.active{background:#ffffff16;color:#fff}.aside-bottom{margin-top:auto}.aside-bottom button{width:100%}.demo-note{color:#8f7c6e;font-size:11px;padding:14px 13px 0}main{grid-column:2;min-width:0}header{height:88px;background:rgba(255,253,249,.94);border-bottom:1px solid var(--border);padding:0 34px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:10;backdrop-filter:blur(12px)}.eyebrow{text-transform:uppercase;letter-spacing:1.4px;font-size:10px;font-weight:700;color:var(--accent);margin-bottom:3px}header h1{font-size:22px}.header-actions{display:flex;align-items:center;gap:10px}.header-actions select{border:1px solid var(--border);background:var(--surface);padding:10px 34px 10px 12px;border-radius:10px;color:var(--dark)}.icon-button{width:42px;height:42px;border:1px solid var(--border);background:var(--surface);border-radius:10px;display:grid;place-items:center;position:relative}.icon-button i{position:absolute;top:-5px;right:-4px;background:var(--danger);color:#fff;border-radius:20px;font-size:9px;font-style:normal;padding:2px 5px}.profile-chip{border:0;background:transparent;display:flex;align-items:center;gap:9px;color:var(--dark)}.profile-chip>span,.avatar{width:36px;height:36px;display:grid;place-items:center;border-radius:10px;background:#eadcca;color:var(--primary);font-weight:700;font-size:12px}.profile-chip b{font-size:13px}.page{padding:30px 34px 50px}.stack{display:flex;flex-direction:column;gap:22px}.welcome{display:flex;justify-content:space-between;align-items:flex-end}.welcome p{font-size:13px;color:var(--muted);text-transform:capitalize}.welcome h2{font-size:24px;margin-top:4px}.live{background:#edf5eb;color:var(--success);font-size:12px;font-weight:700;padding:8px 12px;border-radius:30px}.live i{display:inline-block;width:7px;height:7px;border-radius:10px;background:var(--success);margin-right:5px}.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow)}.kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.kpi{padding:18px;display:grid;grid-template-columns:42px 1fr;column-gap:12px}.kpi-icon{grid-row:1/4;width:40px;height:40px;border-radius:10px;display:grid;place-items:center;background:#f0e5d7;color:var(--primary)}.kpi-icon.green{background:#e9f2e7;color:var(--success)}.kpi p{font-size:12px;color:var(--muted)}.kpi>b{font-size:21px;margin:2px 0}.kpi small{font-size:11px;color:var(--success)}.site-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.site-card{background:var(--surface);border:1px solid var(--border);padding:16px;border-radius:var(--radius);display:flex;align-items:center;gap:11px;text-align:left;color:var(--dark);transition:.2s}.site-card:hover{transform:translateY(-2px);box-shadow:var(--shadow);border-color:var(--accent)}.site-icon{width:40px;height:40px;border-radius:10px;background:#f3eadf;color:var(--primary);display:grid;place-items:center}.site-card span:nth-child(2){display:flex;flex-direction:column}.site-card small{color:var(--muted);font-size:10px}.site-card strong{margin-left:auto}.dashboard-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:16px}.dashboard-grid>.card{padding:20px}.card-title{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px}.card-title h3{font-size:16px}.card-title p{font-size:12px;color:var(--muted);margin-top:3px}.more{border:0;background:transparent;color:var(--muted)}.bars{display:flex;flex-direction:column;gap:14px}.bar-row{display:grid;grid-template-columns:100px 1fr 105px;gap:12px;align-items:center;font-size:11px}.bar-row>div{height:8px;background:#eee6dc;border-radius:10px;overflow:hidden}.bar-row i{display:block;height:100%;background:var(--accent);border-radius:10px}.bar-row b{text-align:right}.sparkline{height:95px;margin-top:20px}.sparkline svg{width:100%;height:100%;overflow:visible}.sparkline path{fill:none;stroke:var(--primary);stroke-width:3}.sparkline path.fill{fill:rgba(185,128,74,.1);stroke:none}.alert-list{display:flex;flex-direction:column}.alert-row{border:0;border-bottom:1px solid var(--border);background:transparent;padding:12px 0;display:flex;align-items:center;gap:10px;text-align:left;color:var(--dark)}.alert-row:last-child{border:0}.alert-row>span:nth-child(2){display:flex;flex-direction:column;flex:1}.alert-row b{font-size:12px}.alert-row small{font-size:10px;color:var(--muted)}.alert-dot{width:33px;height:33px;border-radius:9px;display:grid;place-items:center}.alert-dot.red{background:#f9e4e2;color:var(--danger)}.alert-dot.orange{background:#fff0d8;color:var(--warning)}.alert-dot.green{background:#e7f2e5;color:var(--success)}.activity-list{display:flex;flex-direction:column}.activity{display:flex;gap:10px;padding:11px 0;border-bottom:1px solid var(--border);align-items:center}.activity:last-child{border:0}.activity>span{width:31px;height:31px;background:#f3eadf;color:var(--primary);border-radius:9px;display:grid;place-items:center}.activity>div{flex:1}.activity b{font-size:12px}.activity p,.activity small{font-size:10px;color:var(--muted)}.production-card{text-align:center}.production-ring{width:135px;height:135px;border-radius:50%;margin:8px auto 20px;display:grid;place-items:center;background:conic-gradient(var(--success) 96%,#eee 0);position:relative}.production-ring::after{content:'';position:absolute;inset:11px;border-radius:50%;background:var(--surface)}.production-ring div{position:relative;z-index:1}.production-ring b,.production-ring span{display:block}.production-ring b{font-size:25px}.production-ring span{font-size:10px;color:var(--muted)}.mini-stats{display:flex;justify-content:center;gap:35px;font-size:11px;color:var(--muted)}.mini-stats b{display:block;font-size:15px;color:var(--dark)}
.login-page{min-height:100vh;display:grid;grid-template-columns:42% 58%;background:var(--surface)}.login-brand{background:var(--dark);color:#fff;padding:45px 9%;display:flex;flex-direction:column;justify-content:space-between}.login-brand>.logo{position:absolute}.login-brand>div:last-child{margin:auto 0}.pill{display:inline-block;background:#ffffff12;color:#dec8b4;border:1px solid #ffffff1a;padding:7px 11px;border-radius:20px;font-size:11px;font-weight:700}.login-brand h1{font-size:48px;line-height:1.08;margin:22px 0}.login-brand h1 em{font-style:normal;color:#d4a36e}.login-brand p{color:#c9bdb3;line-height:1.7;max-width:450px}.login-stats{display:flex;gap:40px;margin-top:48px}.login-stats span{font-size:11px;color:#ab9d92}.login-stats b{display:block;color:#fff;font-size:18px}.login-panel{padding:50px 9%;overflow:auto;max-height:100vh}.login-heading h2{font-size:30px}.login-heading>p:last-child{color:var(--muted);margin-top:7px}.profile-groups{margin-top:34px}.profile-groups h3{text-transform:uppercase;letter-spacing:1px;font-size:10px;color:var(--muted);margin:22px 0 9px}.profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.profile-card{width:100%;border:1px solid var(--border);background:var(--surface);border-radius:11px;padding:11px;display:flex;align-items:center;text-align:left;gap:10px;color:var(--dark);transition:.2s}.profile-card:hover{border-color:var(--accent);background:#fcf8f2;transform:translateX(2px)}.profile-card.featured{border-color:#d6b58f;background:#faf2e8}.profile-card>span:nth-child(2){flex:1}.profile-card b,.profile-card small{display:block}.profile-card b{font-size:12px}.profile-card small{font-size:10px;color:var(--muted);margin-top:2px}
.pos-layout{display:grid;grid-template-columns:1fr 365px;gap:20px;margin:-30px -34px -50px;min-height:calc(100vh - 88px)}.catalog{padding:26px 28px}.search{height:42px;border:1px solid var(--border);background:var(--surface);border-radius:10px;display:flex;align-items:center;gap:8px;padding:0 12px;color:var(--muted)}.search input{border:0;outline:0;background:transparent;width:100%;color:var(--dark)}.filters{display:flex;gap:7px;margin:16px 0}.filters button{border:1px solid var(--border);background:var(--surface);padding:8px 12px;border-radius:20px;font-size:11px;color:var(--muted)}.filters button.active{background:var(--primary);color:#fff;border-color:var(--primary)}.product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:11px}.product{border:1px solid var(--border);background:var(--surface);border-radius:12px;padding:16px;text-align:left;color:var(--dark);transition:.15s}.product:hover{border-color:var(--accent);transform:translateY(-2px)}.product>span{display:block;font-size:31px;margin-bottom:12px}.product b,.product strong,.product small{display:block}.product b{font-size:13px}.product strong{color:var(--primary);font-size:13px;margin-top:3px}.product small{color:var(--muted);font-size:9px;margin-top:8px}.basket{background:var(--surface);border-left:1px solid var(--border);padding:22px;display:flex;flex-direction:column}.basket-head{display:flex;justify-content:space-between;align-items:center;padding-bottom:18px;border-bottom:1px solid var(--border)}.basket-head p{font-size:11px;color:var(--muted)}.basket-head h2{font-size:18px}.basket-head button{border:0;background:#f7e8e5;color:var(--danger);width:35px;height:35px;border-radius:9px;display:grid;place-items:center}.basket-items{flex:1;overflow:auto}.basket-line{display:flex;align-items:center;gap:9px;padding:14px 0;border-bottom:1px solid var(--border)}.basket-line>span{font-size:24px}.basket-line>div:nth-child(2){flex:1}.basket-line b,.basket-line small{display:block;font-size:11px}.basket-line small{color:var(--muted)}.stepper{display:flex;align-items:center;gap:9px}.stepper button{border:1px solid var(--border);background:#fff;width:26px;height:26px;border-radius:8px;display:grid;place-items:center}.stepper svg{width:13px}.basket-total{border-top:1px solid var(--border);padding:18px 0;display:flex;justify-content:space-between}.basket-total span{font-size:13px}.basket-total b{font-size:22px}.payment{display:grid;grid-template-columns:1fr 1fr;gap:7px}.payment button{border:1px solid var(--primary);background:var(--surface);color:var(--primary);padding:11px 4px;border-radius:9px;font-size:11px;font-weight:700}.payment button:first-child{grid-column:1/3;background:var(--primary);color:#fff}.empty{min-height:220px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;color:var(--muted);gap:6px}.empty svg{opacity:.4}.empty b{font-size:13px}.empty p{font-size:11px}
.table-card{padding:22px;overflow:hidden}.list-toolbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}.list-toolbar h2{font-size:20px}.list-toolbar p{font-size:11px;color:var(--muted);margin-top:3px}.list-toolbar .search{width:260px}.table{width:100%;overflow:auto}.tr{display:grid;grid-template-columns:1.4fr 1fr .8fr 1fr 1fr .8fr;align-items:center;min-width:760px;padding:13px 9px;border-bottom:1px solid var(--border);font-size:12px}.tr.th{color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.5px;background:#faf7f2;border-radius:8px}.tr:last-child{border-bottom:0}.product-name{display:flex;align-items:center;gap:9px}.product-name i{font-style:normal;font-size:19px}.badge{font-style:normal;padding:5px 8px;border-radius:15px;font-size:9px;font-weight:700}.badge.ok{background:#e7f2e5;color:var(--success)}.badge.warn{background:#fff0d8;color:#a96c10}.badge.neutral{background:#eee8e1;color:var(--muted)}.tr.expense{grid-template-columns:2fr 1fr 1fr .7fr}.request-row,.quality-row,.user-row,.inventory-row{display:flex;align-items:center;gap:14px;padding:15px 4px;border-bottom:1px solid var(--border)}.request-row>div:nth-child(2),.quality-row>div,.user-row>div:nth-child(2),.inventory-row>div{flex:1}.request-row b,.quality-row b,.user-row b,.inventory-row b{font-size:13px}.request-row p,.quality-row p,.user-row p,.inventory-row p{font-size:10px;color:var(--muted);margin-top:3px}.primary{border:0;background:var(--primary);color:#fff;border-radius:9px;padding:11px 17px;font-weight:700;font-size:12px}.primary.small{padding:8px 12px}.workshop-hero{padding:28px;border-radius:16px;background:linear-gradient(120deg,var(--dark),#714929);color:#fff;display:flex;justify-content:space-between;align-items:center}.workshop-hero h2{font-size:29px;margin:12px 0 4px}.workshop-hero p{font-size:12px;color:#d4c1b2}.yield{width:115px;height:115px;border:8px solid #ffffff2b;border-top-color:#92bd82;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:10px}.yield b{font-size:24px}.step-flow{display:grid;grid-template-columns:repeat(4,1fr);background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:20px}.step-flow>div{position:relative;text-align:center}.step-flow>div:not(:last-child)::after{content:'';position:absolute;top:15px;left:60%;width:80%;height:2px;background:var(--border)}.step-flow>div.done:not(:last-child)::after{background:var(--success)}.step-flow span{position:relative;z-index:2;width:31px;height:31px;border-radius:50%;background:#eee8e1;display:grid;place-items:center;margin:auto;font-size:11px}.step-flow .done span{background:var(--success);color:#fff}.step-flow b,.step-flow small{display:block}.step-flow b{font-size:12px;margin-top:8px}.step-flow small{font-size:10px;color:var(--muted)}.action-card{text-align:center;padding:36px}.action-card>svg{width:44px;height:44px;color:var(--accent)}.action-card h2{margin:10px}.action-card p{color:var(--muted);font-size:13px}.giant{padding:15px 35px;font-size:14px;margin-top:22px}.expiry{width:43px;height:43px;border-radius:10px;display:grid;place-items:center;font-weight:700;font-size:11px}.expiry.e0{background:#f9e4e2;color:var(--danger)}.expiry.e1{background:#fff0d8;color:var(--warning)}.expiry.e2{background:#f4eddf;color:var(--primary)}.outline{border:1px solid var(--border);background:transparent;border-radius:9px;padding:9px 13px;font-size:11px;font-weight:700}.outline.danger{color:var(--danger);border-color:#e5bebb}.inventory-row>span{font-size:26px}.inventory-row input{border:1px solid var(--border);border-radius:9px;padding:10px;width:130px}.permissions{display:flex;gap:18px;font-size:11px}.permissions label{display:flex;align-items:center;gap:5px}.close-panel{max-width:540px;margin:20px auto;padding:42px;text-align:center}.close-panel>svg{width:50px;height:50px;color:var(--accent)}.close-panel>p{font-size:12px;color:var(--muted);margin:7px 0 26px}.close-value{background:#f6f0e8;border-radius:10px;padding:18px;display:flex;justify-content:space-between}.close-panel label{display:flex;flex-direction:column;text-align:left;gap:7px;font-size:11px;font-weight:700;margin-top:15px}.close-panel input{border:1px solid var(--border);border-radius:10px;padding:13px}.difference{padding:10px;border-radius:8px;margin-top:10px;font-weight:700;font-size:12px}.difference.ok{background:#e7f2e5;color:var(--success)}.difference.bad{background:#f9e4e2;color:var(--danger)}.toast{position:fixed;right:25px;bottom:25px;background:var(--dark);color:#fff;padding:13px 18px;border-radius:10px;box-shadow:var(--shadow);display:flex;gap:9px;align-items:center;font-size:12px;z-index:100;animation:slide .25s ease}.toast svg{color:#9aca8b}@keyframes slide{from{transform:translateY(15px);opacity:0}}.modal-backdrop{position:fixed;inset:0;background:#23191099;display:grid;place-items:center;z-index:200}.ticket-modal{position:relative;background:var(--surface);padding:35px;width:330px;border-radius:14px;text-align:center}.modal-close{position:absolute;right:12px;top:12px;border:0;background:none}.ticket-logo{color:var(--accent);width:38px;height:38px}.ticket-modal h2{margin:8px}.ticket-modal p{font-size:11px;color:var(--muted);line-height:1.8}.ticket-total{font-size:28px;font-weight:700;padding:20px;margin:20px 0;border-top:1px dashed var(--border);border-bottom:1px dashed var(--border)}.ticket-modal .primary{width:100%;margin-top:20px}
@media(max-width:1050px){.kpi-grid{grid-template-columns:1fr 1fr}.product-grid{grid-template-columns:repeat(3,1fr)}.profile-chip b{display:none}.dashboard-grid{grid-template-columns:1fr}.login-page{grid-template-columns:36% 64%}.login-brand h1{font-size:37px}}
@media(max-width:760px){.app-shell{display:block;padding-bottom:68px}aside{inset:auto 0 0 0;width:auto;height:68px;padding:7px;background:var(--dark);display:block}aside>.logo,.aside-bottom{display:none}nav{margin:0;display:grid;grid-auto-flow:column;grid-auto-columns:1fr;overflow-x:auto;gap:2px}nav button{padding:7px 4px;flex-direction:column;gap:3px;font-size:9px;justify-content:center}main{display:block}header{height:72px;padding:0 16px}header h1{font-size:18px}.header-actions select,.profile-chip b,.profile-chip>span{display:none}.page{padding:18px 14px}.welcome{align-items:flex-start}.welcome h2{font-size:19px}.live{display:none}.kpi-grid{grid-template-columns:1fr 1fr;gap:8px}.kpi{padding:12px;grid-template-columns:32px 1fr}.kpi-icon{width:31px;height:31px}.kpi>b{font-size:15px}.kpi p{font-size:9px}.site-cards{grid-template-columns:1fr}.dashboard-grid{grid-template-columns:1fr}.login-page{display:block;background:var(--bg)}.login-brand{padding:25px 22px 30px;min-height:255px}.login-brand>.logo{position:static}.login-brand>div:last-child{margin-top:30px}.login-brand h1{font-size:31px;margin:14px 0}.login-brand p,.login-stats{display:none}.login-panel{padding:26px 18px;max-height:none}.profile-grid{grid-template-columns:1fr}.pos-layout{display:block;margin:-18px -14px;min-height:auto}.catalog{padding:16px}.product-grid{grid-template-columns:repeat(2,1fr)}.basket{border-left:0;border-top:1px solid var(--border);min-height:480px}.filters{overflow:auto}.filters button{white-space:nowrap}.table-card{padding:14px}.list-toolbar{align-items:flex-start;gap:12px}.list-toolbar .search{width:150px}.request-row{flex-wrap:wrap}.step-flow{grid-template-columns:1fr 1fr;gap:20px}.step-flow>div::after{display:none}.workshop-hero{padding:20px}.yield{width:85px;height:85px}.quality-row{align-items:flex-start;flex-wrap:wrap}.quality-row>div{min-width:180px}.inventory-row input{width:100px}.permissions{flex-direction:column;gap:4px}.toast{left:14px;right:14px;bottom:82px}.profile-chip{padding:0}.bar-row{grid-template-columns:80px 1fr}.bar-row b{display:none}}

.header-welcome{font-size:10px;color:var(--muted);margin-top:2px}.login-form{display:flex;flex-direction:column;gap:15px;margin-top:32px}.login-form label,.form-grid label{display:flex;flex-direction:column;gap:6px;font-size:11px;font-weight:700;color:var(--dark)}.login-form input,.form-grid input,.form-grid select{width:100%;border:1px solid var(--border);background:#fff;border-radius:10px;padding:12px;outline:none}.login-form input:focus,.form-grid input:focus,.form-grid select:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(185,128,74,.12)}.password-field{display:flex;border:1px solid var(--border);border-radius:10px;background:#fff;overflow:hidden}.password-field input{border:0}.password-field button{border:0;background:transparent;color:var(--primary);padding:0 12px;font-size:10px;font-weight:700}.login-submit{padding:14px;margin-top:4px}.form-error{display:flex;align-items:center;gap:7px;background:#f9e4e2;color:var(--danger);padding:10px 12px;border-radius:9px;font-size:11px}.demo-accounts{margin-top:22px;border:1px solid var(--border);border-radius:11px;overflow:hidden}.demo-toggle{width:100%;border:0;background:#faf7f2;padding:13px 15px;display:flex;align-items:center;justify-content:space-between;font-size:12px;font-weight:700;color:var(--dark)}.demo-toggle svg{width:16px;transition:.2s}.demo-toggle svg.rotated{transform:rotate(90deg)}.demo-list{max-height:255px;overflow:auto}.demo-list>div{display:flex;align-items:center;padding:9px 13px;border-top:1px solid var(--border)}.demo-list span{flex:1}.demo-list b,.demo-list small{display:block;font-size:10px}.demo-list small{color:var(--muted);margin-top:2px}.demo-list button{border:1px solid var(--border);background:#fff;color:var(--primary);border-radius:7px;padding:6px 9px;font-size:9px;font-weight:700}.site-choice{min-height:100vh;background:var(--dark);display:grid;place-items:center;padding:25px}.site-choice>.logo{position:absolute;left:35px;top:30px;color:#fff}.site-choice-card{width:min(620px,100%);background:var(--surface);padding:36px;border-radius:16px}.site-choice-card>p:not(.eyebrow){color:var(--muted);font-size:12px;margin:7px 0 25px}.site-choice-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.site-choice-grid button{display:flex;align-items:center;gap:12px;border:1px solid var(--border);background:#fff;padding:15px;border-radius:11px;text-align:left;color:var(--dark)}.site-choice-grid button:hover{border-color:var(--accent)}.site-choice-grid button>span{flex:1}.site-choice-grid b,.site-choice-grid small{display:block}.site-choice-grid small{font-size:9px;color:var(--muted);margin-top:3px}.back-link{border:0;background:transparent;color:var(--muted);font-size:11px;margin-top:20px}.list-toolbar .primary{display:flex;align-items:center;gap:6px}.row-actions{display:flex;gap:6px}.row-actions button{border:1px solid var(--border);background:#fff;border-radius:7px;padding:6px 8px;font-size:9px}.danger-text{color:var(--danger)}.user-row.disabled{opacity:.55}.form-modal{width:min(650px,calc(100% - 28px));background:var(--surface);border-radius:14px;padding:25px}.modal-heading{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:22px}.modal-heading>button{border:0;background:transparent}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:22px}
@media(max-width:760px){.header-welcome{display:none}.site-choice-grid,.form-grid{grid-template-columns:1fr}.site-choice-card{padding:24px}.row-actions{width:100%;overflow:auto}.user-row{flex-wrap:wrap}.login-form{margin-top:22px}}
.demo-tabs{display:flex;gap:4px;padding:9px;overflow-x:auto;border-top:1px solid var(--border)}.demo-tabs button{border:0;background:#f3eee7;color:var(--muted);border-radius:7px;padding:7px 9px;font-size:9px;white-space:nowrap}.demo-tabs button.active{background:var(--primary);color:#fff}.demo-search{margin:0 10px 7px;border:1px solid var(--border);border-radius:8px;display:flex;align-items:center;gap:6px;padding:0 8px;color:var(--muted)}.demo-search input{border:0;outline:0;width:100%;padding:8px 0;font-size:10px}.team-group{margin-top:22px;border-top:1px solid var(--border)}.team-group>h3{padding:13px 4px 4px;font-size:13px}.team-group>h3 span{font-size:9px;color:var(--muted);font-weight:500;margin-left:6px}.site-cards{grid-template-columns:repeat(4,1fr)}
@media(max-width:1100px){.site-cards{grid-template-columns:repeat(2,1fr)}}@media(max-width:760px){.site-cards{grid-template-columns:1fr}}
.production-entry{padding:28px;max-width:760px;margin:auto;width:100%}.production-entry .expected{text-align:center;font-size:15px;margin-bottom:22px}.production-entry>label,.block-label{display:flex;flex-direction:column;gap:7px;font-size:12px;font-weight:700;margin-top:18px}.number-pad{display:grid;grid-template-columns:70px 70px 1fr 70px 70px;gap:8px;margin-top:8px}.number-pad button{border:1px solid var(--border);background:#f5eee5;border-radius:11px;font-weight:700;font-size:16px}.number-pad input{text-align:center;border:2px solid var(--accent);border-radius:12px;font-size:36px;font-weight:700;width:100%;min-width:0;padding:14px}.live-result{text-align:center;padding:12px;border-radius:9px;font-weight:700;margin-top:12px}.live-result.good{background:#e7f2e5;color:var(--success)}.live-result.medium{background:#fff0d8;color:var(--warning)}.live-result.bad{background:#f9e4e2;color:var(--danger)}.yield.good{border-top-color:var(--success)}.yield.medium{border-top-color:var(--warning)}.yield.bad{border-top-color:var(--danger)}.production-note{border:1px solid var(--border);border-radius:10px;padding:11px;resize:vertical;min-height:44px}.primary:disabled{opacity:.45;cursor:not-allowed}.supply-request{padding:15px;border:1px solid var(--border);border-radius:11px;margin-top:10px}.request-summary{display:flex;align-items:center;gap:11px}.request-summary>div:nth-child(2){flex:1}.request-summary b{font-size:13px}.request-summary p,.request-comment{font-size:10px;color:var(--muted)}.badge.danger{background:#f9e4e2;color:var(--danger)}.request-lines{margin:12px 0 8px;padding:8px 12px;background:#faf7f2;border-radius:8px}.request-lines>div{display:grid;grid-template-columns:1fr 110px 130px;gap:10px;padding:5px 0;font-size:11px}.request-lines small{color:var(--success)}.request-lines small.insufficient{color:var(--danger);font-weight:700}.request-actions{display:flex;justify-content:flex-end;gap:7px;margin-top:10px}.dynamic-line{display:grid;grid-template-columns:1fr 120px;gap:10px;align-items:center;margin:10px 0}.dynamic-line select,.dynamic-line input{border:1px solid var(--border);border-radius:9px;padding:10px;background:#fff}.dynamic-line b{font-size:12px}
@media(max-width:760px){.number-pad{grid-template-columns:52px 52px 1fr 52px 52px}.number-pad input{font-size:27px;padding:11px 3px}.production-entry{padding:18px}.request-summary{flex-wrap:wrap}.request-lines>div{grid-template-columns:1fr 80px}.request-lines small{grid-column:1/3}.request-actions{justify-content:flex-start;flex-wrap:wrap}}
.ingredients{display:flex;gap:10px;flex-wrap:wrap;margin:16px 0}.ingredients span{background:#f6f0e8;padding:8px 11px;border-radius:8px;font-size:11px}.batch-stepper{display:grid;grid-template-columns:repeat(5,1fr);margin-bottom:28px}.batch-stepper>div{text-align:center;position:relative}.batch-stepper>div:not(:last-child)::after{content:'';position:absolute;left:60%;right:-40%;top:15px;height:2px;background:var(--border)}.batch-stepper>div.done:not(:last-child)::after{background:var(--success)}.batch-stepper span{position:relative;z-index:1;margin:auto;width:31px;height:31px;border-radius:50%;display:grid;place-items:center;background:#eee8e1;font-size:10px}.batch-stepper .done span{background:var(--success);color:#fff}.batch-stepper b,.batch-stepper small{display:block}.batch-stepper b{font-size:9px;margin-top:6px}.batch-stepper small{font-size:8px;color:var(--muted);padding:0 4px}.batch-row{display:flex;align-items:center;gap:12px;padding:13px 8px;border-bottom:1px solid var(--border);cursor:pointer}.batch-row:hover,.batch-row.selected{background:#faf5ee}.batch-row>div:nth-child(2){flex:1}.batch-row p{font-size:9px;color:var(--muted)}.batch-loss{text-align:center;min-width:62px}.batch-loss small,.batch-loss b{display:block;font-size:9px}.batch-loss b{font-size:14px}.rate{min-width:62px;text-align:center}.rate.good{color:var(--success)}.rate.medium{color:var(--warning)}.rate.bad{color:var(--danger)}
@media(max-width:760px){.batch-stepper{overflow-x:auto;grid-template-columns:repeat(5,120px)}.batch-row{flex-wrap:wrap}.batch-row>div:nth-child(2){min-width:180px}.batch-loss{min-width:52px}.batch-row .primary{width:100%}}
.quick-actions{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:20px}.quick-actions button{border:1px solid var(--border);background:var(--surface);color:var(--primary);border-radius:11px;padding:15px;display:flex;align-items:center;justify-content:center;gap:8px;font-weight:700;font-size:11px}.quick-actions button.primary{background:var(--primary);color:#fff}.toolbar-actions{display:flex;align-items:center;gap:9px}.stock-error{display:flex;align-items:center;gap:10px;background:#f9e4e2;color:var(--danger);padding:12px;border-radius:10px;margin:12px 0;font-size:11px;font-weight:600}.stock-error span{flex:1}.stock-error button{border:0;background:var(--danger);color:#fff;border-radius:7px;padding:8px 10px;font-size:10px;font-weight:700}
@media(max-width:760px){.quick-actions{grid-template-columns:1fr 1fr}.toolbar-actions{width:100%;flex-wrap:wrap}.toolbar-actions .search{width:100%}.stock-error{align-items:flex-start;flex-wrap:wrap}.stock-error button{width:100%}}
.production-toolbar{display:flex;align-items:center;gap:9px}.production-toolbar>div:first-child{margin-right:auto}.date-picker{display:flex;border:1px solid var(--border);border-radius:9px;overflow:hidden;background:#fff}.date-picker button,.date-picker input{border:0;background:#fff;padding:9px}.production-filters{display:grid;grid-template-columns:180px 200px 1fr;gap:9px}.production-filters select,.production-filters input{border:1px solid var(--border);background:#fff;border-radius:9px;padding:10px}.production-kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:9px}.production-table{overflow:auto}.production-tr{display:grid;grid-template-columns:1.3fr 1fr 1.2fr 1.4fr .7fr 1fr .7fr .8fr;align-items:center;gap:8px;min-width:980px;width:100%;padding:12px;border:0;border-bottom:1px solid var(--border);background:transparent;text-align:left;color:var(--dark);font-size:10px}.production-tr:not(.head):hover{background:#faf5ee}.production-tr.head{background:#f7f2ea;text-transform:uppercase;color:var(--muted);font-weight:700}.production-tr span>b,.production-tr span>small{display:block}.production-tr small{color:var(--muted);font-size:8px;margin-top:2px}.batch-modal{overflow:auto;padding:20px}.batch-detail{background:var(--surface);border-radius:14px;padding:25px;width:min(1050px,100%);max-height:94vh;overflow:auto}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.detail-grid section{border:1px solid var(--border);border-radius:10px;padding:16px}.detail-grid h3{font-size:13px;margin:4px 0 12px}.detail-grid p{font-size:10px;color:var(--muted);margin:8px 0}.detail-line{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--border);font-size:10px}.detail-line span:first-child{flex:1}.detail-line button{border:0;color:var(--primary);background:#f3eadf;border-radius:6px;padding:5px}.detail-total{display:flex;justify-content:space-between;padding-top:12px;font-size:12px}.metrics{display:flex;gap:8px;flex-wrap:wrap}.metrics span{background:#f7f2ea;padding:8px;border-radius:8px;font-size:9px}.metrics b{display:block;font-size:15px;margin-top:2px}.history{display:flex;gap:8px;padding:7px 0}.history svg{width:16px;color:var(--accent)}.history b,.history small{display:block;font-size:9px}.history small{color:var(--muted)}
@media(max-width:1050px){.production-kpis{grid-template-columns:repeat(3,1fr)}}@media(max-width:760px){.production-toolbar{align-items:stretch;flex-wrap:wrap}.production-toolbar>div:first-child{width:100%}.production-filters{grid-template-columns:1fr}.production-kpis{grid-template-columns:1fr 1fr}.detail-grid{grid-template-columns:1fr}}
.back-button{align-self:flex-start;border:0;background:transparent;color:var(--primary);font-weight:700}.inventory-board{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;align-items:start}.inventory-board>section{padding:14px}.inventory-board>section>h3{font-size:12px;margin-bottom:10px}.inventory-card{width:100%;display:flex;align-items:center;gap:9px;border:1px solid var(--border);background:#fff;padding:10px;border-radius:9px;text-align:left;color:var(--dark);margin-top:7px}.inventory-card>span:nth-child(2){flex:1}.inventory-card b,.inventory-card small{display:block;font-size:10px}.inventory-card small,.empty-column{color:var(--muted);font-size:8px}.empty-column{text-align:center;padding:18px}.inventory-head{display:flex;align-items:center;justify-content:space-between;padding:20px}.inventory-head p{font-size:10px;color:var(--muted);margin-top:3px}.inventory-actions{display:flex;gap:7px}.progress-card{padding:16px}.progress-card>div{display:flex;justify-content:space-between}.progress-card i{display:block;height:8px;background:#eee;border-radius:10px;margin:10px 0;overflow:hidden}.progress-card i span{display:block;height:100%;background:var(--success)}.progress-card p{display:flex;align-items:center;gap:5px;font-size:10px;color:var(--muted)}.inventory-groups section{margin-top:14px}.inventory-groups h3{font-size:12px;margin:8px}.count-row{display:grid;grid-template-columns:36px 1fr 260px 1fr;gap:10px;align-items:center;background:var(--surface);border:1px solid var(--border);padding:11px;border-radius:10px;margin-top:6px}.count-row>span{font-size:22px}.count-row b,.count-row small{display:block;font-size:11px}.count-row small{color:var(--muted)}.count-controls{display:grid;grid-template-columns:1fr 45px 45px;gap:5px}.count-controls input,.count-controls button,.count-note{border:1px solid var(--border);background:#fff;border-radius:8px;padding:9px;min-width:0}.count-controls button{font-weight:700;color:var(--primary)}.inventory-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.reconcile-tr{display:grid;grid-template-columns:1.4fr .7fr .7fr .7fr 1fr 1.3fr;gap:8px;padding:11px;min-width:720px;border-bottom:1px solid var(--border);font-size:10px}.reconcile-tr.head{background:#f7f2ea;text-transform:uppercase;color:var(--muted)}.reconcile-tr.exact{border-left:3px solid var(--success)}.reconcile-tr.minor{border-left:3px solid var(--warning);background:#fffaf1}.reconcile-tr.major{border-left:3px solid var(--danger);background:#fff5f4}
@media(max-width:1100px){.inventory-board{grid-template-columns:1fr 1fr}.count-row{grid-template-columns:36px 1fr 220px}.count-note{grid-column:2/4}.inventory-summary{grid-template-columns:1fr 1fr}}@media(max-width:760px){.inventory-board{grid-template-columns:1fr}.inventory-head{align-items:flex-start;flex-direction:column;gap:12px}.inventory-actions{flex-wrap:wrap}.count-row{grid-template-columns:32px 1fr}.count-controls,.count-note{grid-column:1/3}.inventory-summary{grid-template-columns:1fr 1fr}}
.inventory-filters{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.inventory-filters select{border:1px solid var(--border);background:#fff;border-radius:9px;padding:10px}.inventory-card.detailed{display:block;padding:11px}.inventory-card-top{display:flex;align-items:center;gap:8px}.inventory-card-top>span:nth-child(2){flex:1}.inventory-card dl{margin:10px 0 7px;display:flex;flex-direction:column;gap:5px}.inventory-card dl>div{display:flex;justify-content:space-between;gap:8px;font-size:8px}.inventory-card dt{color:var(--muted)}.inventory-card dd{margin:0;text-align:right;font-weight:700}.inventory-card dd small{display:block;font-weight:400;color:var(--muted)}.card-progress{height:4px;background:#eee;border-radius:5px;overflow:hidden}.card-progress i{display:block;height:100%;background:var(--success)}.surprise-option{display:flex;gap:10px;align-items:flex-start;padding:12px;background:#fff7e9;border:1px solid #f0d6a8;border-radius:9px;margin-top:15px}.surprise-option span{display:flex;flex-direction:column}.surprise-option b{font-size:11px}.surprise-option small{font-size:9px;color:var(--muted)}.inventory-timeline{padding:18px}.inventory-timeline>h3{font-size:14px;margin-bottom:13px}.timeline-event{display:grid;grid-template-columns:28px 1fr auto;gap:10px;align-items:start;position:relative;padding-bottom:14px}.timeline-event>span{width:25px;height:25px;border-radius:50%;display:grid;place-items:center;background:var(--success);color:#fff;font-size:9px}.timeline-event b,.timeline-event p,.timeline-event em,.timeline-event time{display:block;font-size:10px}.timeline-event p,.timeline-event time{color:var(--muted)}.timeline-event em{color:var(--danger);margin-top:3px}
@media(max-width:760px){.inventory-filters{grid-template-columns:1fr 1fr}.timeline-event{grid-template-columns:28px 1fr}.timeline-event time{grid-column:2}}

/* Connected workspace surfaces */
html,body,#root{max-width:100%;overflow-x:hidden}body{background:#fff}.app-shell,main,.page{background:#fff}.app-shell .card,.app-shell .kpi,.app-shell .table-card{background:#f5eee3;border-color:#e6dccb;box-shadow:0 4px 18px rgba(59,42,31,.045)}header{background:rgba(255,255,255,.96);border-bottom-color:#e6dccb}.app-shell .tr.th,.app-shell .production-tr.head,.app-shell .reconcile-tr.head{background:#ebe1d3}.badge.ok{background:#dcebd8}.badge.warn{background:#f7e4bd}.badge.neutral{background:#e2d8ca;color:#554a42}

/* Unsplash bakery hero — Photo by Maite Paternain */
.login-brand{position:relative;isolation:isolate;overflow:hidden;background:#3b2a1f}.login-brand::before{content:'';position:absolute;inset:0;z-index:-2;background:url('https://images.unsplash.com/photo-1732565729552-994c6af761e3?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixlib=rb-4.1.0&q=85&w=1600') center/cover no-repeat;animation:heroReveal 1.2s ease both}.login-brand::after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(to bottom,rgba(59,42,31,.55),rgba(59,42,31,.85))}.login-brand .pill,.login-stats span{backdrop-filter:blur(10px);background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.16);border-radius:12px;padding:10px 13px}.login-stats span{min-width:135px}.login-panel{background:#fff}@keyframes heroReveal{from{opacity:0;transform:scale(1.04)}to{opacity:1;transform:scale(1)}}

.help-page{display:flex;flex-direction:column;gap:18px}.help-hero{background:linear-gradient(120deg,var(--dark),var(--primary));color:#fff;border-radius:16px;padding:28px;display:flex;gap:18px;align-items:center}.help-hero>svg{width:44px;height:44px}.help-hero p:last-child{color:#ddcec2;margin-top:5px}.help-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.help-grid section{padding:20px}.help-grid h3{margin-bottom:13px}.help-grid p{display:flex;gap:9px;padding:7px 0;font-size:12px}.help-grid p span,.help-grid p b{width:23px;height:23px;display:grid;place-items:center;border-radius:50%;background:#dfebd9;color:var(--success);flex:none}.try-card{border-left:4px solid var(--accent)!important}.tour-overlay{position:fixed;inset:0;background:rgba(25,17,12,.68);z-index:500}.tour-spot{position:absolute;left:265px;top:95px;right:24px;height:120px;border:2px solid #fff;border-radius:16px;box-shadow:0 0 0 9999px rgba(25,17,12,.08)}.tour-popover{position:absolute;right:40px;top:235px;width:360px;background:#fff;padding:22px;border-radius:14px;box-shadow:0 20px 60px rgba(0,0,0,.25)}.tour-popover>span{font-size:10px;color:var(--accent);font-weight:700}.tour-popover h3{margin:7px 0}.tour-popover p{font-size:12px;color:var(--muted);line-height:1.5}.tour-popover>div{display:flex;justify-content:flex-end;gap:7px;margin-top:18px}.tour-popover button{border:0;background:transparent;padding:9px;font-size:11px}.tutorial-button{display:grid}

@media(max-width:760px){
  .login-brand{height:220px;min-height:220px;padding:18px 20px}.login-brand>div:last-child{margin-top:24px}.login-brand h1{font-size:27px}.login-panel{padding:24px 16px}.page{padding:16px}.kpi-grid,.production-kpis,.inventory-summary{grid-template-columns:1fr}.header-actions{gap:5px}.header-actions .icon-button{width:40px;height:40px}.profile-chip{min-width:40px}header{padding:0 12px}.card,.table-card{max-width:100%}.modal-backdrop{align-items:stretch;padding:0}.form-modal,.ticket-modal,.batch-detail{width:100%;max-width:none;height:100%;max-height:none;border-radius:0;overflow:auto;padding:20px 16px 88px}.modal-actions{position:sticky;bottom:0;background:inherit;padding:12px 0}.pos-layout{max-width:100%}.product-grid{grid-template-columns:1fr 1fr}.basket{width:100%}.help-grid{grid-template-columns:1fr}.tour-spot{left:12px;right:12px;top:75px;height:90px}.tour-popover{left:16px;right:16px;bottom:82px;top:auto;width:auto}.site-choice{padding:16px}.login-stats{display:none}
}
@media(min-width:761px) and (max-width:1024px){.kpi-grid{grid-template-columns:1fr 1fr}.page{padding:24px}.product-grid{grid-template-columns:repeat(3,1fr)}}

.workshop-tabs{display:flex;gap:7px;overflow:auto}.workshop-tabs button{border:1px solid var(--border);background:#fff;padding:10px 14px;border-radius:9px;white-space:nowrap;font-size:11px;font-weight:700}.workshop-tabs button.active{background:var(--primary);color:#fff}.workshop-kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:9px}.workshop-form{padding:24px}.workshop-form>label{display:block;font-size:11px;font-weight:700;margin:16px 0 7px}.workshop-form textarea{border:1px solid var(--border);border-radius:9px;padding:10px;min-height:70px}.workshop-steps{display:flex;gap:6px;overflow:auto;margin:18px 0}.workshop-steps span{display:flex;align-items:center;gap:6px;white-space:nowrap;background:#e9dfd1;padding:8px 10px;border-radius:20px;font-size:9px}.workshop-steps b{width:20px;height:20px;display:grid;place-items:center;border-radius:50%;background:var(--accent);color:#fff}.workshop-report{overflow:auto}.workshop-report-row{display:grid;grid-template-columns:.8fr 1.4fr 1.2fr 1fr 1fr 1fr .8fr;gap:8px;min-width:820px;padding:11px;border-bottom:1px solid var(--border);font-size:10px;align-items:center}.workshop-report-row.head{background:#e9dfd1;text-transform:uppercase;color:var(--muted);font-weight:700}
.help-backdrop{position:fixed;inset:0;background:rgba(24,16,11,.5);z-index:550}.help-drawer{position:absolute;right:0;top:0;bottom:0;width:min(480px,100%);background:#fff;padding:24px;overflow:auto;box-shadow:-20px 0 50px rgba(0,0,0,.18)}.help-drawer-head{display:flex;justify-content:space-between;align-items:flex-start;padding-bottom:18px;border-bottom:1px solid var(--border)}.help-drawer-head button{border:0;background:transparent}.help-drawer section{padding:18px 0;border-bottom:1px solid var(--border)}.help-drawer h3{font-size:14px;margin-bottom:9px}.help-drawer p,.help-drawer li{font-size:11px;line-height:1.55;color:var(--muted)}.help-drawer ul{padding-left:18px}.help-drawer details{border:1px solid var(--border);border-radius:8px;margin-top:7px}.help-drawer summary{padding:10px;display:flex;align-items:center;gap:8px;font-size:11px;font-weight:700;cursor:pointer}.help-drawer summary b{width:21px;height:21px;border-radius:50%;display:grid;place-items:center;background:#eee3d5}.help-drawer details p{padding:0 10px 10px}.work-flow{display:flex;align-items:center;justify-content:space-between;gap:5px;background:#f5eee3;padding:10px;border-radius:8px;margin-bottom:8px;font-size:9px}.try-help{background:#fff8ed;padding:14px!important;border-radius:9px;margin-top:14px}.restart-tour{width:100%;margin:18px 0}.tour-points{display:flex!important;justify-content:center!important;gap:5px!important;margin:14px 0 0!important}.tour-points i{width:7px;height:7px;border-radius:50%;background:#d5cabd}.tour-points i.active{background:var(--primary);width:20px;border-radius:5px}.tour-actions{margin-top:10px!important}.tour-actions button:disabled{opacity:.35}.tour-spot{transition:.25s ease;right:auto;bottom:auto}
@media(max-width:1100px){.workshop-kpis{grid-template-columns:repeat(2,1fr)}}@media(max-width:760px){.workshop-kpis{grid-template-columns:1fr}.workshop-form{padding:16px}.help-drawer{width:100%;padding:18px 16px}.tour-spot{display:none}}

/* Login mobile: compact image banner followed by visible form */
@media(max-width:767px){
  .login-page{display:block;min-height:100vh;background:#fff}
  .login-brand{height:260px;min-height:260px;max-height:260px;padding:16px;display:flex;flex-direction:column;justify-content:flex-start;gap:12px}
  .login-brand>.logo{position:static;flex:none}
  .login-brand>div:last-child{margin:0;display:flex;flex-direction:column;align-items:flex-start;gap:10px;min-width:0}
  .login-brand .pill{font-size:9px;padding:6px 9px;border-radius:12px}
  .login-brand h1{font-size:28px;line-height:1.02;margin:0;max-width:100%}
  .login-brand p{display:-webkit-box;font-size:13px;line-height:1.35;max-width:100%;overflow:hidden;-webkit-line-clamp:2;-webkit-box-orient:vertical}
  .login-stats{display:flex!important;gap:16px;margin:0;width:100%;align-items:center}
  .login-stats span{display:flex!important;align-items:baseline;gap:5px;background:none;border:0;backdrop-filter:none;padding:0;min-width:0;font-size:9px;color:#e4d8cf}
  .login-stats b{display:inline;font-size:12px}
  .login-panel{position:relative;margin-top:-12px;border-radius:18px 18px 0 0;padding:22px 16px 30px;max-height:none;overflow:visible;background:#fff}
  .login-heading h2{font-size:24px}.login-heading>p:last-child{font-size:11px}
  .login-form{margin-top:16px;gap:11px}.login-form input{padding:10px}.login-submit{padding:12px}
}

/* Theme and onboarding refinements */
*{transition-property:background-color,border-color,color,box-shadow;transition-duration:.2s;transition-timing-function:ease}.login-brand::after{background:linear-gradient(to bottom,rgba(59,42,31,.22),rgba(59,42,31,.58))}.login-brand .pill,.login-stats span{backdrop-filter:blur(3px);background:rgba(59,42,31,.24)}.theme-switch{height:42px;display:flex;align-items:center;gap:5px;border:1px solid var(--border);background:#fff;border-radius:10px;padding:0 7px;color:var(--primary)}.theme-switch svg{width:16px}.theme-switch select{border:0;background:transparent;color:inherit;font-size:10px;font-weight:700;outline:0}.tour-popover{padding-top:42px}.skip-tour{position:absolute;right:12px;top:10px!important;color:var(--muted);font-size:9px!important;text-decoration:underline}.tour-points button{width:8px;height:8px;border:0;padding:0;border-radius:50%;background:#d5cabd;cursor:pointer}.tour-points button.active{background:var(--primary);width:22px;border-radius:5px}.tour-actions{justify-content:flex-end!important}.tour-actions button{min-width:82px}.tour-actions .primary{display:inline-flex;align-items:center;justify-content:center}
html[data-theme="dark"]{--bg:#1d1c1a;--surface:#292724;--border:#4a4540;--primary:#d7a36e;--dark:#f5eee6;--accent:#e1a96e;--muted:#c1b7ad;--success:#76b873;--warning:#f0ae45;--danger:#e46d6d;color-scheme:dark}html[data-theme="dark"] body,html[data-theme="dark"] .app-shell,html[data-theme="dark"] main,html[data-theme="dark"] .page{background:#1d1c1a;color:#f5eee6}html[data-theme="dark"] header,html[data-theme="dark"] .help-drawer,html[data-theme="dark"] .tour-popover,html[data-theme="dark"] .form-modal,html[data-theme="dark"] .ticket-modal,html[data-theme="dark"] .batch-detail{background:#242220;color:#f5eee6}html[data-theme="dark"] .app-shell .card,html[data-theme="dark"] .app-shell .kpi,html[data-theme="dark"] .app-shell .table-card{background:#292724;border-color:#4a4540}html[data-theme="dark"] input,html[data-theme="dark"] select,html[data-theme="dark"] textarea,html[data-theme="dark"] .search,html[data-theme="dark"] .theme-switch{background:#302e2b;color:#f5eee6;border-color:#4a4540}html[data-theme="dark"] .login-panel{background:#1d1c1a;color:#f5eee6}html[data-theme="dark"] .login-brand::after{background:linear-gradient(to bottom,rgba(20,17,14,.3),rgba(20,17,14,.66))}html[data-theme="dark"] .product,html[data-theme="dark"] .profile-card,html[data-theme="dark"] .inventory-card,html[data-theme="dark"] .stepper button{background:#292724;color:#f5eee6;border-color:#4a4540}html[data-theme="dark"] .badge.neutral{background:#49443e;color:#f5eee6}
@media(max-width:760px){.theme-switch{width:42px}.theme-switch select{position:absolute;width:42px;height:42px;opacity:0}.tour-popover{padding-top:40px}.tour-actions{display:grid!important;grid-template-columns:1fr 1fr}.tour-actions .primary{min-height:44px}}

/* Accessible tutorial action in both themes */
.tour-popover .tour-actions .primary{background:var(--action-bg)!important;color:var(--action-text)!important;border:1px solid var(--action-bg)!important;border-radius:9px!important;box-shadow:0 5px 14px rgba(59,42,31,.16);opacity:1;visibility:visible}.tour-popover .tour-actions .primary:hover{background:var(--accent)!important;border-color:var(--accent)!important;transform:translateY(-1px)}.tour-popover .tour-actions .primary:focus-visible{outline:3px solid color-mix(in srgb,var(--accent) 45%,transparent);outline-offset:2px}

/* Dedicated warm dark-theme tokens and contrast fixes */
html[data-theme="dark"]{--page-bg:#1c1a18;--card-bg:#282522;--field-bg:#302c29;--sidebar-bg:#211e1b;--text-main:#f7f1e9;--text-soft:#c9c0b7;--border:#514a43;--primary:#e0aa73;--accent:#e6a96a;--action-bg:#b9783e;--action-text:#fffaf4;--menu-hover:#3b342e;--success:#85c47f;--warning:#f2b34f;--danger:#ee7777;--shadow:0 10px 28px rgba(0,0,0,.24)}
html[data-theme="dark"] body,html[data-theme="dark"] .app-shell,html[data-theme="dark"] main,html[data-theme="dark"] .page{background:var(--page-bg);color:var(--text-main)}
html[data-theme="dark"] aside{background:var(--sidebar-bg);color:var(--text-main);border-right:1px solid #3a342e}
html[data-theme="dark"] aside .logo,html[data-theme="dark"] aside .logo b{color:#fffaf4}
html[data-theme="dark"] aside .logo small{color:#d8c7b8}
html[data-theme="dark"] nav button,html[data-theme="dark"] .aside-bottom button{color:#d9d0c8}
html[data-theme="dark"] nav button:hover,html[data-theme="dark"] nav button.active,html[data-theme="dark"] .aside-bottom button:hover{background:#3a332d;color:#fff}
html[data-theme="dark"] .demo-note{color:#bdb1a6}
html[data-theme="dark"] header{background:#24211f;color:var(--text-main);border-bottom-color:var(--border)}
html[data-theme="dark"] .app-shell .card,html[data-theme="dark"] .app-shell .kpi,html[data-theme="dark"] .app-shell .table-card,html[data-theme="dark"] .production-entry{background:var(--card-bg);color:var(--text-main);border-color:var(--border);box-shadow:var(--shadow)}
html[data-theme="dark"] input,html[data-theme="dark"] select,html[data-theme="dark"] textarea,html[data-theme="dark"] .search,html[data-theme="dark"] .theme-switch,html[data-theme="dark"] .password-field{background:var(--field-bg);color:var(--text-main);border-color:var(--border)}
html[data-theme="dark"] input::placeholder,html[data-theme="dark"] textarea::placeholder{color:#a99f96}
html[data-theme="dark"] input:focus,html[data-theme="dark"] select:focus,html[data-theme="dark"] textarea:focus{outline:2px solid var(--accent);outline-offset:1px;border-color:var(--accent)}
html[data-theme="dark"] .muted,html[data-theme="dark"] .card-title p,html[data-theme="dark"] .welcome p,html[data-theme="dark"] .activity p,html[data-theme="dark"] .activity small,html[data-theme="dark"] .product small,html[data-theme="dark"] .header-welcome{color:var(--text-soft)}
html[data-theme="dark"] .workshop-hero{background:linear-gradient(120deg,#28221d,#4a3325);color:#fffaf4;border:1px solid #5a493c}
html[data-theme="dark"] .workshop-hero p{color:#ded3c8}
html[data-theme="dark"] .workshop-hero .pill{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.18);color:#fffaf4}
html[data-theme="dark"] .number-pad button,html[data-theme="dark"] .stepper button,html[data-theme="dark"] .filters button,html[data-theme="dark"] .outline,html[data-theme="dark"] .back-button{background:#342f2b;color:#f7f1e9;border-color:#625950}
html[data-theme="dark"] .number-pad button:hover,html[data-theme="dark"] .stepper button:hover,html[data-theme="dark"] .filters button:hover,html[data-theme="dark"] .outline:hover{background:#463c34;border-color:var(--accent);color:#fff}
html[data-theme="dark"] .ingredients span,html[data-theme="dark"] .workshop-steps span,html[data-theme="dark"] .close-value,html[data-theme="dark"] .metrics span{background:#37312c;color:#f4ede5}
html[data-theme="dark"] .primary{background:var(--action-bg);color:var(--action-text)}
html[data-theme="dark"] .primary:hover{background:#ca8749}

/* Login demo accounts: dark only, light mode remains untouched */
html[data-theme="dark"] .login-panel{background:var(--page-bg);color:var(--text-main)}
html[data-theme="dark"] .demo-accounts{background:#24211f;border-color:#514a43;box-shadow:0 8px 24px rgba(0,0,0,.22)}
html[data-theme="dark"] .demo-toggle{background:#2d2926;color:#f7f1e9;border-color:#514a43}
html[data-theme="dark"] .demo-toggle:hover{background:#38312c;color:#fff}
html[data-theme="dark"] .demo-tabs{background:#24211f;border-color:#514a43}
html[data-theme="dark"] .demo-tabs button{background:#35302c;color:#ddd3ca}
html[data-theme="dark"] .demo-tabs button:hover,html[data-theme="dark"] .demo-tabs button.active{background:var(--accent);color:#261b13}
html[data-theme="dark"] .demo-search{background:#302c29;border-color:#514a43;color:#f7f1e9}
html[data-theme="dark"] .demo-list{background:#24211f;color:#f7f1e9;box-shadow:0 10px 22px rgba(0,0,0,.2)}
html[data-theme="dark"] .demo-list>div{border-color:#45403a}
html[data-theme="dark"] .demo-list>div:hover{background:#3a312a}
html[data-theme="dark"] .demo-list b{color:#f7f1e9}
html[data-theme="dark"] .demo-list small{color:#c9c0b7}
html[data-theme="dark"] .demo-list button{background:#352e28;color:#f3c18f;border-color:#66564a}
html[data-theme="dark"] .demo-list button:hover{background:var(--accent);color:#281b12}
html[data-theme="dark"] .tour-popover{background:#292623;color:#f7f1e9;border:1px solid #514a43}
html[data-theme="dark"] .tour-popover p{color:#c9c0b7}
html[data-theme="dark"] .tour-popover .tour-actions>button:not(.primary){color:#f1e8df;background:#37312c;border:1px solid #625950;border-radius:9px}

/* Global dark-surface safety net: every neutral surface uses theme tokens */
html[data-theme="dark"]{--header-bg:#24211f;--modal-bg:#282522;--menu-bg:#2b2825;--secondary-bg:#35312d;--hover-bg:#403a34;--selected-bg:#4a3b30;--icon-color:#f7f1e9;--chevron-color:#f4e9df;--focus-ring:#e6a96a;--surface:var(--card-bg);--bg:var(--page-bg);--muted:var(--text-soft);--dark:var(--text-main)}
html[data-theme="dark"] :where(h1,h2,h3,h4,h5,h6,b,strong,label,dt,dd){color:var(--text-main)}
html[data-theme="dark"] :where(p,small,time,.eyebrow + p){color:var(--text-soft)}
html[data-theme="dark"] :where(svg){color:currentColor}
html[data-theme="dark"] :where(.site-choice,.login-page,.site-choice-card,.login-panel){background-color:var(--page-bg);color:var(--text-main)}
html[data-theme="dark"] .site-choice{background:var(--page-bg)}
html[data-theme="dark"] .site-choice>.logo{color:var(--text-main)}
html[data-theme="dark"] .site-choice>.logo .logo-mark{color:#fff;background:var(--accent)}
html[data-theme="dark"] .site-choice>.logo small{color:var(--text-soft)}
html[data-theme="dark"] .site-choice-card{background:var(--card-bg);border:1px solid var(--border);box-shadow:var(--shadow)}
html[data-theme="dark"] .site-choice-card>p:not(.eyebrow){color:var(--text-soft)}
html[data-theme="dark"] .site-choice-grid button{background:var(--secondary-bg);color:var(--text-main);border-color:var(--border);box-shadow:0 3px 10px rgba(0,0,0,.12)}
html[data-theme="dark"] .site-choice-grid button small{color:var(--text-soft)}
html[data-theme="dark"] .site-choice-grid button svg{color:var(--chevron-color)}
html[data-theme="dark"] .site-choice-grid button:hover,html[data-theme="dark"] .site-choice-grid button:focus-visible{background:var(--hover-bg);border-color:var(--accent);color:#fff;transform:translateY(-1px)}
html[data-theme="dark"] .back-link{color:var(--text-soft)}

html[data-theme="dark"] :where(.profile-card,.site-card,.product,.alert-row,.request-row,.quality-row,.user-row,.inventory-row,.count-row,.supply-request,.batch-row,.production-tr,.reconcile-tr,.workshop-report-row,.activity,.basket-line){color:var(--text-main);border-color:var(--border)}
html[data-theme="dark"] :where(.profile-card,.site-card,.product,.inventory-card,.count-row,.supply-request){background:var(--card-bg)}
html[data-theme="dark"] :where(.profile-card,.site-card,.product,.inventory-card,.batch-row,.production-tr):hover{background:var(--hover-bg);border-color:var(--accent)}
html[data-theme="dark"] :where(.profile-card.featured,.batch-row.selected,.filters button.active,.workshop-tabs button.active){background:var(--selected-bg);color:var(--text-main);border-color:var(--accent)}
html[data-theme="dark"] :where(.profile-card small,.site-card small,.product small,.request-row p,.quality-row p,.user-row p,.inventory-row p,.basket-line small,.batch-row p,.production-tr small){color:var(--text-soft)}
html[data-theme="dark"] :where(.site-icon,.activity>span,.kpi-icon,.avatar){background:var(--secondary-bg);color:var(--icon-color)}

html[data-theme="dark"] :where(.tr.th,.production-tr.head,.reconcile-tr.head,.workshop-report-row.head){background:#35312d;color:#d8cfc6}
html[data-theme="dark"] :where(.tr,.production-tr,.reconcile-tr,.workshop-report-row){border-bottom-color:var(--border)}
html[data-theme="dark"] :where(.reconcile-tr.major,.reconcile-tr.minor,.reconcile-tr.exact){background:var(--card-bg)}
html[data-theme="dark"] .reconcile-tr.major{border-left-color:var(--danger)}
html[data-theme="dark"] .reconcile-tr.minor{border-left-color:var(--warning)}
html[data-theme="dark"] .reconcile-tr.exact{border-left-color:var(--success)}

html[data-theme="dark"] :where(.form-modal,.ticket-modal,.batch-detail,.close-panel,.help-drawer,.tour-popover){background:var(--modal-bg);color:var(--text-main);border-color:var(--border)}
html[data-theme="dark"] :where(.modal-heading,.basket-head,.card-title,.list-toolbar){border-color:var(--border)}
html[data-theme="dark"] :where(.modal-close,.modal-heading>button,.help-drawer-head button,.icon-button,.profile-chip){color:var(--icon-color)}
html[data-theme="dark"] .icon-button{background:var(--secondary-bg);border-color:var(--border)}
html[data-theme="dark"] .icon-button:hover,html[data-theme="dark"] .icon-button:focus-visible{background:var(--hover-bg);border-color:var(--accent)}

html[data-theme="dark"] :where(.basket,.catalog,.pos-layout){background:var(--page-bg);color:var(--text-main);border-color:var(--border)}
html[data-theme="dark"] :where(.basket-head button){background:#482d2b;color:#ffaaa3}
html[data-theme="dark"] :where(.filters button,.workshop-tabs button,.demo-list button,.row-actions button,.payment button){background:var(--secondary-bg);color:var(--text-main);border-color:var(--border)}
html[data-theme="dark"] :where(.filters button,.workshop-tabs button,.demo-list button,.row-actions button,.payment button):hover{background:var(--hover-bg);color:#fff;border-color:var(--accent)}
html[data-theme="dark"] .payment button:first-child{background:var(--action-bg);color:var(--action-text);border-color:var(--action-bg)}

html[data-theme="dark"] :where(.request-lines,.tr.th,.production-tr.head,.inventory-card dl,.work-flow,.detail-grid section,.help-drawer details,.surprise-option,.progress-card,.close-value){background:var(--secondary-bg);color:var(--text-main);border-color:var(--border)}
html[data-theme="dark"] :where(.detail-line,.history,.timeline-event,.team-group,.help-drawer section,.demo-list>div){border-color:var(--border)}
html[data-theme="dark"] :where(.card-progress,.progress-card i,.bar-row>div){background:#4b453f}
html[data-theme="dark"] :where(.empty,.empty-column){color:var(--text-soft)}

html[data-theme="dark"] :where(.toast){background:#332d28;color:#fff;border:1px solid #5c5148;box-shadow:var(--shadow)}
html[data-theme="dark"] :where(.modal-backdrop,.help-backdrop){background:rgba(14,12,10,.72)}
html[data-theme="dark"] :where(.demo-toggle,.demo-tabs,.demo-search,.demo-list,.dropdown-menu,[role="menu"],[role="listbox"]){background:var(--menu-bg);color:var(--text-main);border-color:var(--border)}
html[data-theme="dark"] :where(option){background:var(--menu-bg);color:var(--text-main)}

html[data-theme="dark"] :where(button,a,input,select,textarea,[tabindex]):focus-visible{outline:3px solid color-mix(in srgb,var(--focus-ring) 55%,transparent);outline-offset:2px}
html[data-theme="dark"] :where(button:not(:disabled),.profile-card,.site-card,.inventory-card){transition:background-color .18s ease,border-color .18s ease,color .18s ease,transform .18s ease}
html[data-theme="dark"] :where(.ChevronRight,[data-chevron]){color:var(--chevron-color)}
